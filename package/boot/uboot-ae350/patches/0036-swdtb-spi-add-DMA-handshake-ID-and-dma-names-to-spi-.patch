--- a/board/andestech/common/swdtb_merger/swdtb_merger_fixup.c
+++ b/board/andestech/common/swdtb_merger/swdtb_merger_fixup.c
@@ -817,7 +817,7 @@ int mmc_dma_rxtx_fixup(void *fdt, int node, char *name, char *value)
 						    dma_names, dma_rxtx);
 			if (ret) {
 				printf("fdt_appendprop_string: err=%s\n",
-				fdt_strerror(ret));
+				       fdt_strerror(ret));
 				return ret;
 			}
 
@@ -838,53 +838,17 @@ int mmc_dma_rxtx_fixup(void *fdt, int node, char *name, char *value)
  */
 int mmc_dma_dmas_fixup(void *fdt, int node, char *name, char *value)
 {
-#define DMA_DMAS_HANDSHAKE_ID	0x9
 	const char *target_node = "mmc";
-	const char *dmas = "dmas";
 	const char *full_name;
-	const char *dma_compat = "andestech,atcdmac300";
-	const char *dma_compat_g = "andestech,atcdmac300g";
+	struct dmas dmas_array[1];
 
-	int dmanode;
-	int dma_phandle;
-	int ret;
-	fdt32_t dmas_array[2];
+	/* The even indices of the array store the DMA's phandle. */
+	dmas_array[0].handshake_id = cpu_to_fdt32(DMA_HANDSHAKE_ID_MMC);
 
 	full_name = fdt_get_name(fdt, node, NULL);
 	if (strncmp(full_name, target_node, strlen(target_node)) == 0) {
-		const u32 *value;
-
-		value = fdt_getprop(fdt, node, dmas, NULL);
-		if (value)
-			return RETURN_DONE;
-
-		dmanode = find_node_for_gnog(fdt, dma_compat, dma_compat_g);
-		if (dmanode <= 0)
-			return dmanode;
-
-		dma_phandle = fdt_get_phandle(fdt, dmanode);
-		if (!dma_phandle) {
-			dma_phandle = fdt_create_phandle(fdt, dmanode);
-			if (!dma_phandle) {
-				dtb_error("Error on fdt_get_phandle: %s\n",
-					  fdt_strerror(dma_phandle));
-				return dma_phandle;
-			}
-		}
-
-		dmas_array[0] = cpu_to_fdt32(dma_phandle);
-		dmas_array[1] = cpu_to_fdt32(DMA_DMAS_HANDSHAKE_ID);
-
-		ret = fdt_appendprop(fdt, node, dmas,
-				     dmas_array, 2 * sizeof(fdt32_t));
-		if (ret) {
-			printf("fdt_appendprop: err=%s\n", fdt_strerror(ret));
-			return ret;
-		}
-
-		show_result_multi_num(fdt, node, dmas, 2);
-
-		return ret;
+		return dma_set_dmas_array(fdt, node, dmas_array,
+					  ARRAY_SIZE(dmas_array));
 	}
 
 	return !(RETURN_DONE);
@@ -914,7 +878,7 @@ int dma_cells_fixup(void *fdt, int node, char *name, char *value)
 						  dma_cells, cells_value);
 			if (ret) {
 				printf("fdt_appendprop_string: err=%s\n",
-				fdt_strerror(ret));
+				       fdt_strerror(ret));
 				return ret;
 			}
 
@@ -1018,3 +982,76 @@ int uart_baudrate_fixup(void *fdt, int node, char *name, char *value)
 
 	return RETURN_DONE;
 }
+
+/**
+ * This fixup will add the dma_names into spi node.
+ * @return 0 if ok, or FDT_ERR... if not.
+ */
+int spi_dma_rxtx_fixup(void *fdt, int node, char *name, char *value)
+{
+	const char *target_node = "spi";
+	const char *dma_names = "dma-names";
+	const char *dma_spi_tx = "spi_tx";
+	const char *dma_spi_rx = "spi_rx";
+	const char *full_name;
+	int ret;
+
+	full_name = fdt_get_name(fdt, node, NULL);
+	if (strncmp(full_name, target_node, strlen(target_node)) == 0) {
+		const u32 *value;
+
+		value = fdt_getprop(fdt, node, dma_names, NULL);
+		if (!value) {
+			show_rawdtb(dma_spi_tx, target_node);
+			/* add default property of fixed link */
+			ret = fdt_appendprop_string(fdt, node,
+						    dma_names, dma_spi_tx);
+			if (ret) {
+				printf("fdt_appendprop_string: err=%s\n",
+				       fdt_strerror(ret));
+				return ret;
+			}
+
+			show_rawdtb(dma_spi_rx, target_node);
+			/* add default property of fixed link */
+			ret = fdt_appendprop_string(fdt, node,
+						    dma_names, dma_spi_rx);
+			if (ret) {
+				printf("fdt_appendprop_string: err=%s\n",
+				       fdt_strerror(ret));
+				return ret;
+			}
+
+			show_result(fdt, node, dma_names, RESULT_STRING);
+		}
+
+		return ret;
+	}
+
+	return !(RETURN_DONE);
+}
+
+/**
+ * This fixup will add the dmas into spi node.
+ * dmas has two variable, the first is point to the dma node,
+ * the second is the fixed handshake id.
+ * @return 0 if ok, or FDT_ERR... if not.
+ */
+int spi_dma_dmas_fixup(void *fdt, int node, char *name, char *value)
+{
+	const char *target_node = "spi";
+	const char *full_name;
+	struct dmas dmas_array[2];
+
+	/* The even indices of the array store the DMA's phandle. */
+	dmas_array[0].handshake_id = cpu_to_fdt32(DMA_HANDSHAKE_ID_SPI_TX);
+	dmas_array[1].handshake_id = cpu_to_fdt32(DMA_HANDSHAKE_ID_SPI_RX);
+
+	full_name = fdt_get_name(fdt, node, NULL);
+	if (strncmp(full_name, target_node, strlen(target_node)) == 0) {
+		return dma_set_dmas_array(fdt, node, dmas_array,
+					  ARRAY_SIZE(dmas_array));
+	}
+
+	return !(RETURN_DONE);
+}
diff --git a/board/andestech/common/swdtb_merger/swdtb_merger_fixup.h b/board/andestech/common/swdtb_merger/swdtb_merger_fixup.h
