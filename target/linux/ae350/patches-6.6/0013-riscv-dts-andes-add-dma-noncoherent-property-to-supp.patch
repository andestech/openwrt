 			reg = <0x00 0xe0100000 0x00 0x1000>;
 			interrupts = <0x13 0x04>;
 			interrupt-parent = <0x02>;
+			dma-noncoherent;
 		};
 
 		smu@f0100000 {
@@ -189,6 +190,7 @@ mmc@f0e00000 {
 			fifo-depth = <0x10>;
 			dma-names = "rxtx";
 			dmas = <0x03 0x09>;
+			dma-noncoherent;
 		};
 
 		dma@f0c00000 {
@@ -199,6 +201,7 @@ dma@f0c00000 {
 			dma-channels = <0x08>;
 			#dma-cells = <0x01>;
 			phandle = <0x03>;
+			dma-noncoherent;
 		};
 
 		lcd@e0200000 {
@@ -206,6 +209,7 @@ lcd@e0200000 {
 			reg = <0x00 0xe0200000 0x00 0x1000>;
