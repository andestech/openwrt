+/**
+ * The insert_inject_node() function will add the injection node to
+ * reserved-memory. If reserved-memory does not exist, this function
+ * will create it as well.
+ * reserved-memory {
+ *     #address-cells = <0x02>;
+ *     #size-cells = <0x02>;
+ *     ranges;
+ *     andes_inject@100000 {
+ *         compatible = "inject";
+ *         reg = <0x00 0x100000 0x00 0x100000>;
+ *         reusable;
+ *     };
+ * };
+ *
+ * @return 0 if ok, or FDT_ERR... if not.
+ */
+int insert_inject_node(void *fdt, int node, char *name, char *value)
+{
+	struct fdt_memory inject_node = {
+		.start = ANDES_INJECT_NODE_START,
+		.end = ANDES_INJECT_NODE_START + ANDES_INJECT_NODE_SIZE - 1,
+	};
+
+	unsigned long flags = 0;
+	int ret;
+	const char *node_name = "andes_inject";
+	const char *compatible = "inject";
+	int reserved_off;
+	int inject_off;
+	u32 phandle;
+	u32 rmem_offset;
+
+	reserved_off = fdt_path_offset(fdt, "/reserved-memory");
+	if (reserved_off > 0) {
+		inject_off = fdt_subnode_offset(fdt, reserved_off, node_name);
+		if (inject_off > 0) {
+			/* The target node andes_inject already exists */
+			return RETURN_DONE;
+		}
+	}
+
+	/* Inject the reserved-memory nodes into the DTS */
+	ret = fdtdec_add_reserved_memory(fdt, node_name, &inject_node,
+					 &compatible, 1, &phandle, flags);
+	if (ret) {
+		dtb_error("fdtdec_add_reserved_memory failed:%s\n",
+			  fdt_strerror(ret));
+		return ret;
+	}
+
+	/*
+	 * In order to find the node we added, use the "phandle"
+	 * to point to it.
+	 */
+	rmem_offset = fdt_node_offset_by_phandle(fdt, phandle);
+	if (rmem_offset)
+		fdt_setprop_empty(fdt, rmem_offset, "reusable");
+
+	ret = show_reserved_memory_node(fdt, rmem_offset, compatible);
+
+	return ret;
+}
+
+/**
+ * This fixup will add the injection node to reserved-memory.
+ * If reserved-memory does not exist, this fixup will create it as well.
+ * reserved-memory {
+ *     #address-cells = <0x02>;
+ *      #size-cells = <0x02>;
+ *      ranges;
+ *      andes_dma_global_pool0@3e800000 {
+ *           linux,dma-default;
+ *           compatible = "shared-dma-pool";
+ *           reg = <0x00 0x3e800000 0x00 0x200000>;
+ *           phandle = <0x06>;
+ *           no-map;
+ *     };
+ * };
+ *
+ * @return 0 if ok, or FDT_ERR... if not.
+ */
+int dma_global_pool_fixup(void *fdt, int node, char *name, char *value)
+{
+	/* For AE350 platform */
+	struct fdt_memory dma_pool = {
+		.start = ANDES_DMA_POOL_NODE_START,
+		.end = ANDES_DMA_POOL_NODE_START + ANDES_DMA_POOL_NODE_SIZE - 1,
+	};
+
+	unsigned long flags = FDTDEC_RESERVED_MEMORY_NO_MAP;
+	int ret;
+	int reserved_off;
+	int dma_off;
+	const char *node_name = "dma_global_pool0";
+	const char *compatible = "shared-dma-pool";
+	const char *dma_default = "linux,dma-default";
+	u32 phandle;
+	u32 rmem_offset;
+
+	reserved_off = fdt_path_offset(fdt, "/reserved-memory");
+	if (reserved_off > 0) {
+		dma_off = fdt_subnode_offset(fdt, reserved_off, node_name);
+		if (dma_off > 0) {
+			/* The target node dma_global_pool0 already exists */
+			return RETURN_DONE;
+		}
+	}
+
+	/* Inject the reserved-memory nodes into the DTS */
+	ret = fdtdec_add_reserved_memory(fdt, node_name, &dma_pool,
+					 &compatible, 1, &phandle, flags);
+	if (ret) {
+		dtb_error("fdtdec_add_reserved_memory failed: %s\n",
+			  fdt_strerror(ret));
+		return ret;
+	}
+
+	rmem_offset = fdt_node_offset_by_phandle(fdt, phandle);
+	if (rmem_offset)
+		fdt_setprop_empty(fdt, rmem_offset, dma_default);
+
+	ret = show_reserved_memory_node(fdt, rmem_offset, compatible);
+
+	return ret;
+}
