 enum dma_type global_dma_type;
+enum dtb_type global_dtb_type;
 
 void swdtb_global_initial(void)
 {
@@ -21,6 +22,7 @@ void swdtb_global_initial(void)
 	 * Please note the life of these variables.
 	 */
 	global_dma_type = DMA_TYPE_INIT;
