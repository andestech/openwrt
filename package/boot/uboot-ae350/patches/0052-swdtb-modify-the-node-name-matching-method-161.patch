-
-	if (strncmp(full_name, target_node, strlen(target_node)) == 0) {
+	if (fdt_node_name_cmp(fdt, node, target_node)) {
 		const u32 *value;
 
 		value = fdt_getprop(fdt, node, tx_name, NULL);
@@ -758,14 +749,12 @@ int andespmu_event_fixup(void *fdt, int node, char *name, char *value)
 {
 	const char *target_node = "pmu";
 	const char *cpu_prop = "model";
-	const char *full_name;
 	const char *cpu_mode;
 	const char *cpu_str;
 	unsigned long cpu;
 	int ret;
 
-	full_name = fdt_get_name(fdt, node, NULL);
-	if (strncmp(full_name, target_node, strlen(target_node)) == 0) {
+	if (fdt_node_name_cmp(fdt, node, target_node)) {
 		cpu_mode = fdt_getprop(fdt, 0, cpu_prop, NULL);
 		if (!cpu_mode) {
 			dtb_error("Not found cpu model\n");
