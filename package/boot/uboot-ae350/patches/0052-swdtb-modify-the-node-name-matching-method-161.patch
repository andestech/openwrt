-	full_name = fdt_get_name(fdt, node, NULL);
-
-	if (strncmp(full_name, target_node, strlen(target_node)) == 0) {
+	if (fdt_node_name_cmp(fdt, node, target_node)) {
 		const u32 *value;
 
 		value = fdt_getprop(fdt, node, target_name, NULL);
@@ -417,13 +414,10 @@ int l2c_interrupt_fixup(void *fdt, int node, char *name, char *value)
 	int irq_cells;
 
 	const fdt32_t *irq_prop;
-	const char *full_name;
 	u32 tmp[2];
 	int ret;
 
-	full_name = fdt_get_name(fdt, node, NULL);
-
-	if (strncmp(full_name, target_node, strlen(target_node)) == 0) {
+	if (fdt_node_name_cmp(fdt, node, target_node)) {
 		const u32 *value;
 
 		value = fdt_getprop(fdt, node, target, NULL);
@@ -507,15 +501,12 @@ int spi_quad_read_fixup(void *fdt, int node, char *name, char *value)
 	const char *target_node = "flash";
 	const char *tx_name = "spi-tx-bus-width";
 	const char *rx_name = "spi-rx-bus-width";
-	const char *full_name;
 	const u32 tx_value = 4;
 	const u32 rx_value = 4;
