+int ae350_fdt_add_pmu(void *fdt, int node, unsigned long cpu)
+{
+	struct event_select *selects =
+		(struct event_select *)andes_hw_evt_selects;
+	struct event_counter *counters =
+		(struct event_counter *)andes_hw_evt_cnters;
+	struct raw_event_counter *rcounters;
+
+	if (cpu == 65)
+		rcounters = (struct raw_event_counter *)andes65_raw_evt_cnters;
+	else if (cpu == 45)
+		rcounters = (struct raw_event_counter *)andes45_raw_evt_cnters;
+	else
+		rcounters = (struct raw_event_counter *)andes2x_raw_evt_cnters;
+
+	return fdt_add_pmu(fdt, node, selects, counters, rcounters);
+}
+
+void show_hpm_data(void *fdt, int node, const char *name, int row)
+{
+#if ANDES_SWDTB_MERGER_CHECK_HPM
+	const u32 *offset;
+	u32 len;
+
+	offset = fdt_getprop(fdt, node, name, &len);
+	printf("%s%s%s:\n", KYEL, name, KNRM);
+	for (int idx = 0; idx < len / 4; idx++) {
+		printf("%08x", fdt32_to_cpu(*(offset + idx)));
+		if ((idx % row) == (row - 1))
+			printf("\n");
+		else
+			printf(" ");
+	}
+#else
+	printf("Andes PMU: %s%s%s\n", KYEL, name, KNRM);
+#endif
+}
+
+int fdt_add_pmu(void *fdt, int node,
+		struct event_select *selects,
+		struct event_counter *counters,
+		struct raw_event_counter *rcounters)
+{
+	int i, ret;
+	/* An entry of "riscv,event-to-mhpmevent" */
+	fdt32_t evt_to_mhpmevent[3];
+	/* An entry of "riscv,event-to-mhpmcounters" */
+	fdt32_t evt_to_mhpmcounters[3];
+	/* An entry of "riscv,raw-event-to-mhpmcounters" */
+	fdt32_t raw_evt_to_mhpmcounters[5];
+
+	const char *mhpmevent = "riscv,event-to-mhpmevent";
+	const char *mhpmcounters = "riscv,event-to-mhpmcounters";
+	const char *raw_event_to_mhpm = "riscv,raw-event-to-mhpmcounters";
+
+	/* The compatible string must be "riscv,pmu" */
+	ret = fdt_setprop_string(fdt, node, "compatible", "riscv,pmu");
+	if (ret)
+		return ret;
+
+	/*
+	 * If some of properties have been provided, do nothing,
+	 * we assume it's a valid pmu node.
+	 * see: https://github.com/riscv-software-src/opensbi/blob/master/docs/pmu_support.md#sbi-pmu-device-tree-bindings
+	 */
+	if (fdt_getprop(fdt, node, mhpmevent, NULL) ||
+	    fdt_getprop(fdt, node, mhpmcounters, NULL) ||
+	    fdt_getprop(fdt, node, raw_event_to_mhpm, NULL)) {
+		/* HPM event is existed! */
+		return RETURN_DONE;
+	}
+
+	/*
+	 * If "riscv,event-to-mhpmevent" is present,
+	 * "riscv,event-to-mhpmcounters" must be provided as well.
+	 */
+	if (selects && !counters)
+		return -EINVAL;
+
+	/* Add riscv,event-to-mhpmevent */
+	for (i = 0; selects && selects[i].eidx; i++) {
+		evt_to_mhpmevent[0] = cpu_to_fdt32(selects[i].eidx);
+		evt_to_mhpmevent[1] = cpu_to_fdt32(selects[i].select >> 32);
+		evt_to_mhpmevent[2] = cpu_to_fdt32(selects[i].select & ~0UL);
+
+		ret = fdt_appendprop(fdt, node, mhpmevent,
+				     evt_to_mhpmevent,
+				     sizeof(struct event_select));
+		if (ret) {
+			printf("Error on set %s: %d\n", mhpmevent, ret);
+			return ret;
+		}
+	}
+
+	/* Add riscv,event-to-mhpmcounters */
+	for (i = 0; counters && counters[i].eidx_start; i++) {
+		evt_to_mhpmcounters[0] = cpu_to_fdt32(counters[i].eidx_start);
+		evt_to_mhpmcounters[1] = cpu_to_fdt32(counters[i].eidx_end);
+		evt_to_mhpmcounters[2] = cpu_to_fdt32(counters[i].ctr_map);
+
+		ret = fdt_appendprop(fdt, node, mhpmcounters,
+				     evt_to_mhpmcounters,
+				     sizeof(struct event_counter));
+		if (ret) {
+			printf("Error on set %s: %d\n", mhpmcounters, ret);
+			return ret;
+		}
+	}
+
+	/* Add riscv,raw-event-to-mhpmcounters */
+	for (i = 0; rcounters && rcounters[i].select; i++) {
+		raw_evt_to_mhpmcounters[0] =
+			cpu_to_fdt32(rcounters[i].select >> 32);
+		raw_evt_to_mhpmcounters[1] =
+			cpu_to_fdt32(rcounters[i].select & ~0UL);
+		raw_evt_to_mhpmcounters[2] =
+			cpu_to_fdt32(rcounters[i].select_mask >> 32);
+		raw_evt_to_mhpmcounters[3] =
+			cpu_to_fdt32(rcounters[i].select_mask & ~0UL);
+		raw_evt_to_mhpmcounters[4] =
+			cpu_to_fdt32(rcounters[i].ctr_map);
+
+		ret = fdt_appendprop(fdt, node, raw_event_to_mhpm,
+				     raw_evt_to_mhpmcounters,
+				     sizeof(struct raw_event_counter));
+		if (ret) {
+			printf("Error on set %s: %d\n", raw_event_to_mhpm, ret);
+			return ret;
+		}
+	}
+
+	show_hpm_data(fdt, node, mhpmevent,
+		      sizeof(struct event_select) / sizeof(uint32_t));
+	show_hpm_data(fdt, node, mhpmcounters,
+		      sizeof(struct event_counter) / sizeof(uint32_t));
+	show_hpm_data(fdt, node, raw_event_to_mhpm,
+		      sizeof(struct raw_event_counter) / sizeof(uint32_t));
+
+	return RETURN_DONE;
+}
