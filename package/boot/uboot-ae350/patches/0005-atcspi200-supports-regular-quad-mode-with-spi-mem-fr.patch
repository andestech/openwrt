+static int atcspi200_spi_mem_exec_op(struct spi_slave *slave,
+				     const struct spi_mem_op *op)
+{
+	struct udevice *bus;
+	struct nds_spi_slave *ns;
+	int ret;
+
+	bus = slave->dev->parent;
+	ns = dev_get_priv(bus);
+	if (op->data.nbytes) {
+		if (op->data.dir == SPI_MEM_DATA_IN) {
+			ns->din = op->data.buf.in;
+			ns->dout = 0;
+		} else {
+			ns->dout = (char *)op->data.buf.out;
+			ns->din = 0;
+		}
+	}
+	ret = atcspi200_spi_setting(ns, op);
+	if (pio_enable)
+		pio_transfer_data(ns, ns->din, ns->dout, op->data.nbytes);
+	else
+		dma_transfer_data(ns, ns->din, ns->dout, op->data.nbytes);
+	ret = __atcspi200_spi_stop(ns);
+
+	return ret;
+}
