 .../common/swdtb_merger/swdtb_merger_fixup.h  |   7 +
 .../common/swdtb_merger/swdtb_tool.c          |  64 ++++++++-
 .../common/swdtb_merger/swdtb_tool.h          |   6 +
 5 files changed, 160 insertions(+), 46 deletions(-)

