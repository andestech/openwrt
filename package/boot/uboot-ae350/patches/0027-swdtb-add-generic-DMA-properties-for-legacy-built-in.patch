 }
+
+/**
+ * This fixup will add the dma_names into mmc node.
+ * @return 0 if ok, or FDT_ERR... if not.
+ */
+int mmc_dma_rxtx_fixup(void *fdt, int node, char *name, char *value)
+{
+	const char *target_node = "mmc";
+	const char *dma_names = "dma-names";
+	const char *dma_rxtx = "rxtx";
+	const char *full_name;
+	int ret;
+
+	full_name = fdt_get_name(fdt, node, NULL);
+	if (strncmp(full_name, target_node, strlen(target_node)) == 0) {
+		const u32 *value;
+
+		value = fdt_getprop(fdt, node, dma_names, NULL);
+		if (!value) {
+			show_rawdtb(dma_rxtx, target_node);
+			/* add default property of fixed link */
+			ret = fdt_appendprop_string(fdt, node,
+						    dma_names, dma_rxtx);
+			if (ret) {
+				printf("fdt_appendprop_string: err=%s\n",
+				fdt_strerror(ret));
+				return ret;
+			}
+
+			show_result(fdt, node, dma_names, RESULT_STRING);
+		}
+
+		return ret;
+	}
+
+	return !(RETURN_DONE);
+}
+
+/**
+ * This fixup will add the dmas into mmc node.
+ * dmas has two variable, the first is point to the dma node,
+ * the second is the fixed handshake id.
+ * @return 0 if ok, or FDT_ERR... if not.
+ */
+int mmc_dma_dmas_fixup(void *fdt, int node, char *name, char *value)
+{
+#define DMA_DMAS_HANDSHAKE_ID	0x9
+	const char *target_node = "mmc";
+	const char *dmas = "dmas";
+	const char *full_name;
+	const char *dma_compat = "andestech,atcdmac300";
+	const char *dma_compat_g = "andestech,atcdmac300g";
+
+	int dmanode;
+	int dma_phandle;
+	int ret;
+	fdt32_t dmas_array[2];
+
+	full_name = fdt_get_name(fdt, node, NULL);
+	if (strncmp(full_name, target_node, strlen(target_node)) == 0) {
+		const u32 *value;
+
+		value = fdt_getprop(fdt, node, dmas, NULL);
+		if (value)
+			return RETURN_DONE;
+
+		dmanode = find_node_for_gnog(fdt, dma_compat, dma_compat_g);
+		if (dmanode <= 0)
+			return dmanode;
+
+		dma_phandle = fdt_get_phandle(fdt, dmanode);
+		if (!dma_phandle) {
+			dma_phandle = fdt_create_phandle(fdt, dmanode);
+			if (!dma_phandle) {
+				dtb_error("Error on fdt_get_phandle: %s\n",
+					  fdt_strerror(dma_phandle));
+				return dma_phandle;
+			}
+		}
+
+		dmas_array[0] = cpu_to_fdt32(dma_phandle);
+		dmas_array[1] = cpu_to_fdt32(DMA_DMAS_HANDSHAKE_ID);
+
+		ret = fdt_appendprop(fdt, node, dmas,
+				     dmas_array, 2 * sizeof(fdt32_t));
+		if (ret) {
+			printf("fdt_appendprop: err=%s\n", fdt_strerror(ret));
+			return ret;
+		}
+
+		show_result_multi_num(fdt, node, dmas, 2);
+
+		return ret;
+	}
+
+	return !(RETURN_DONE);
+}
+
+/**
+ * This fixup will add the #dma-cells into dma node.
+ * The dma-cells are for the format of the 'interrupts' property.
+ * @return 0 if ok, or FDT_ERR... if not.
+ */
+int dma_cells_fixup(void *fdt, int node, char *name, char *value)
+{
+	const char *target_node = "dma";
+	const char *dma_cells = "#dma-cells";
+	const u32 cells_value = 1;
+	const char *full_name;
+	int ret;
+
+	full_name = fdt_get_name(fdt, node, NULL);
+	if (strncmp(full_name, target_node, strlen(target_node)) == 0) {
+		const u32 *value;
+
+		value = fdt_getprop(fdt, node, dma_cells, NULL);
+		if (!value) {
+			show_rawdtb(dma_cells, target_node);
+			ret = fdt_appendprop_cell(fdt, node,
+						  dma_cells, cells_value);
+			if (ret) {
+				printf("fdt_appendprop_string: err=%s\n",
+				fdt_strerror(ret));
+				return ret;
+			}
+
+			show_result(fdt, node, dma_cells, RESULT_NUMERAL);
+
+			return ret;
+		}
+	}
+
+	return !(RETURN_DONE);	
+}
