 				strncat(new_str, rv_str, strlen(rv_str));
@@ -340,6 +348,12 @@ int l2c_cache_line_fixup(void *fdt, int node, char *name, char *value)
 
 		value = fdt_getprop(fdt, node, target_name, NULL);
 		if (!value) {
+			if (global_dtb_type == DTB_TYPE_USER) {
+				dtb_info("Warning: The %s node need (%s)\n",
+					 target_node, target_name);
+				return RETURN_DONE;
+			}
+
 			show_rawdtb(target_name, target_node);
 
 			fdt_refer_node = fdt_path_offset(fdt, refer_node);
@@ -404,6 +418,14 @@ int l2c_interrupt_fixup(void *fdt, int node, char *name, char *value)
 	if (strncmp(full_name, target_node, strlen(target_node)) == 0) {
 		const u32 *value;
 
+		if (global_dtb_type == DTB_TYPE_USER) {
+			/*
+			 * The L2C interrupts does not affect booting process,
+			 * just skip it when not in use with the built-in DTB.
+			 */
+			return RETURN_DONE;
+		}
+
 		value = fdt_getprop(fdt, node, target, NULL);
 		if (value) {
 			/* Find the target in the node skip */
@@ -496,6 +518,14 @@ int spi_quad_read_fixup(void *fdt, int node, char *name, char *value)
 	if (strncmp(full_name, target_node, strlen(target_node)) == 0) {
 		const u32 *value;
 
+		if (global_dtb_type == DTB_TYPE_USER) {
+			/*
+			 * The SPI quad mode does not affect booting process
+			 * just skip it.
+			 */
+			return RETURN_DONE;
+		}
+
 		value = fdt_getprop(fdt, node, tx_name, NULL);
 		if (!value) {
 			show_rawdtb(tx_name, target_node);
@@ -640,6 +670,14 @@ int insert_inject_node(void *fdt, int node, char *name, char *value)
 	u32 phandle;
 	u32 rmem_offset;
 
+	if (global_dtb_type == DTB_TYPE_USER) {
+		/*
+		 * The inject node does not affect booting process,
+		 * just skip it when not in use with the built-in DTB.
+		 */
+		return RETURN_DONE;
+	}
+
 	reserved_off = fdt_path_offset(fdt, "/reserved-memory");
 	if (reserved_off > 0) {
 		inject_off = fdt_subnode_offset(fdt, reserved_off, node_name);
@@ -707,6 +745,14 @@ int dma_global_pool_fixup(void *fdt, int node, char *name, char *value)
 	u32 phandle;
 	u32 rmem_offset;
 
+	if (global_dtb_type == DTB_TYPE_USER) {
+		/*
+		 * The dma global pool node does not affect booting process,
+		 * just skip it when not in use with the built-in DTB.
+		 */
+		return RETURN_DONE;
+	}
+
 	reserved_off = fdt_path_offset(fdt, "/reserved-memory");
 	if (reserved_off > 0) {
 		dma_off = fdt_subnode_offset(fdt, reserved_off, node_name);
diff --git a/board/andestech/common/swdtb_merger/swdtb_tool.c b/board/andestech/common/swdtb_merger/swdtb_tool.c
