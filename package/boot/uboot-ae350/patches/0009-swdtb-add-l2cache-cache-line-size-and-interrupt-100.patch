+/**
+ * The l2c_cache_line_fixup() will read the d-cache-line-size from cpu node
+ * and write to L2C node
+ * "NONE" ==> "cache-line-size = <0x40>;"
+ * in 25 bitmap d-cache-line-size is 32
+ *
+ * @return 0 if ok, or FDT_ERR... if not.
+ */
+int l2c_cache_line_fixup(void *fdt, int node, char *name, char *value)
+{
+	const char *target_node = "l2-cache";
+	const char *target_name = "cache-line-size";
+	const char *refer_node = "/cpus";
+	int cpu_node;
+	const char *cpu_prop = "d-cache-line-size";
+	int fdt_refer_node;
+	const char *full_name;
+	const u32 *target_value;
+	int ret;
+
+	full_name = fdt_get_name(fdt, node, NULL);
+
+	if (strncmp(full_name, target_node, strlen(target_node)) == 0) {
+		const u32 *value;
+
+		value = fdt_getprop(fdt, node, target_name, NULL);
+		if (!value) {
+			show_rawdtb(target_name, target_node);
+
+			fdt_refer_node = fdt_path_offset(fdt, refer_node);
+			cpu_node = fdt_first_subnode(fdt, fdt_refer_node);
+			dtb_debug("The fdt_refer_node value: %d\n",
+				  fdt_refer_node);
+
+			target_value =
+				fdt_getprop(fdt, cpu_node, cpu_prop, NULL);
+
+			dtb_debug("Reference value in CPU node: %d\n",
+				  fdt32_to_cpu(*target_value));
+
+			ret = fdt_appendprop_cell(fdt, node, target_name,
+						  fdt32_to_cpu(*target_value));
+			if (ret) {
+				dtb_error("Error on fdt_appendprop_cell: %s\n",
+					  fdt_strerror(ret));
+			}
+
+			show_result(fdt, node, target_name, RESULT_NUMERAL);
+
+			return ret;
+		}
+	}
+
+	return !(RETURN_DONE);
+}
+
+/**
+ * The l2c_interrupt_fixup() will add the interrupts and interrupt-parent
+ * into the l2-cache
+ * Example:
+ * interrupts = <0x10 0x04>;
+ * interrupt-parent = <0x06>;
+ *
+ * @return 0 if ok, or FDT_ERR... if not.
+ */
+int l2c_interrupt_fixup(void *fdt, int node, char *name, char *value)
+{
+	const char *target_node = "l2-cache";
+	const char *target = "interrupts";
+	const char *target_parent = "interrupt-parent";
+
+	/* AE350 PLIC Interrupt Source */
+	u32 target_pin = 16;
+	u32 target_trig = IRQ_TYPE_LEVEL_HIGH;
+
+	const char *irq_compat = "riscv,plic0";
+	const char *irq_cell_str = "#interrupt-cells";
+	int irq_node;
+	int irq_phandle;
+	int irq_cells;
+
+	const fdt32_t *irq_prop;
+	const char *full_name;
+	u32 tmp[2];
+	int ret;
+
+	full_name = fdt_get_name(fdt, node, NULL);
+
+	if (strncmp(full_name, target_node, strlen(target_node)) == 0) {
+		const u32 *value;
+
+		value = fdt_getprop(fdt, node, target, NULL);
+		if (value) {
+			/* Find the target in the node skip */
+			return RETURN_DONE;
+		}
+
+		show_rawdtb(target, target_node);
+
+		/* Add interrupt-parent */
+		irq_node = fdt_node_offset_by_compatible(fdt, 0, irq_compat);
+		if (irq_node < 0) {
+			dtb_error("Error on fdt_node_offset_by_compatible: %s\n",
+				  fdt_strerror(irq_node));
+			return irq_node;
+		}
+
+		irq_phandle = fdt_get_phandle(fdt, irq_node);
+		if (!irq_phandle) {
+			dtb_error("Error on fdt_get_phandle: %s\n",
+				  fdt_strerror(irq_phandle));
+		}
+
+		/* Add interrupts */
+		irq_prop = fdt_getprop(fdt, irq_node,
+				       irq_cell_str, NULL);
+
+		if (!irq_prop) {
+			dtb_error("Missing %s in interrupt-parent: %d\n",
+				  irq_cell_str, *irq_prop);
+			return -EINVAL;
+		}
+
+		irq_cells = fdt32_to_cpu(*irq_prop);
+		if (irq_cells != 2) {
+			dtb_error("%s is not equal to 2 (%d)\n",
+				  irq_cell_str, irq_cells);
+			return -EINVAL;
+		}
+
+		/* For cell is 2 */
+		ret = fdt_appendprop_u32(fdt, node,
+					 target_parent, irq_phandle);
+		if (ret < 0) {
+			dtb_error("Error on fdt_appendprop_u32 for %s: %s\n",
+				  target_parent, fdt_strerror(ret));
+			return ret;
+		}
+
+		tmp[0] = cpu_to_fdt32(target_pin);
+		tmp[1] = cpu_to_fdt32(target_trig);
+
+		ret = fdt_appendprop(fdt, node, target,
+				     tmp, sizeof(tmp));
+		if (ret) {
+			dtb_error("Error on fdt_appendprop: %s\n",
+				  fdt_strerror(ret));
+		}
+
+		show_result(fdt, node, target, RESULT_NUMERAL);
+		show_result(fdt, node, target_parent, RESULT_NUMERAL);
+
+		return ret;
+	}
+
+	return !(RETURN_DONE);
+}
