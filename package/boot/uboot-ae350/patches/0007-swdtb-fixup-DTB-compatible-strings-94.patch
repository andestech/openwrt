+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Header file for the swdtb merger for Andes dtb
+ *
+ * Copyright (C) 2024 Andes Technology Corporation
+ */
+#ifndef __SWDTB_MERGER_FIXUP_H_
+#define __SWDTB_MERGER_FIXUP_H_
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "swdtb_tool.h"
+#include "swdtb_config.h"
+
+/* For the uncountable */
+#define COUNT_INFINITE	(0xFFFFFFFF)
+#define COUNT_MAX	(4096)
