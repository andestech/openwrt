From bf65e93198af2773d42fc8444555588f034d055e Mon Sep 17 00:00:00 2001
From: Randolph <randolph@andestech.com>
Date: Wed, 7 Aug 2024 19:53:49 +0800
Subject: [PATCH 14/53] swdtb: only fixup when using built-In DTB (#108)

swdtb: only fixup when using built-In DTB

When the DTB is sourced from the built-in DTB, the swdtb merger will
modify it accordingly. If the DTB is not a built-in DTB
(e.g., a user-provided DTB), only a warning message will be shown.

Signed-off-by: Randolph <randolph@andestech.com>
Reviewed-on: https://gitea.andestech.com/RD-SW/u-boot.official/pulls/108
Reviewed-by: Charles Ci-Jyun Wu <dminus@andestech.com>
Reviewed-by: Leo Yu-Chi Liang <ycliang@andestech.com>
Co-authored-by: Randolph <randolph@andestech.com>
Co-committed-by: Randolph <randolph@andestech.com>
---
 board/andestech/ae350/ae350.c                 |  9 +++-
 .../common/swdtb_merger/swdtb_merger.c        | 29 ++++++++----
 .../common/swdtb_merger/swdtb_merger.h        |  4 +-
 .../common/swdtb_merger/swdtb_merger_fixup.c  | 46 +++++++++++++++++++
 .../common/swdtb_merger/swdtb_tool.c          | 14 ++++++
 .../common/swdtb_merger/swdtb_tool.h          |  8 ++++
 6 files changed, 97 insertions(+), 13 deletions(-)

diff --git a/board/andestech/ae350/ae350.c b/board/andestech/ae350/ae350.c
index 1d98dc181a4a..cedae72d85bf 100644
--- a/board/andestech/ae350/ae350.c
+++ b/board/andestech/ae350/ae350.c
@@ -104,6 +104,13 @@ void *ae350_find_fdt_blob(void)
 	return NULL;
 }
 
+#ifdef ANDES_SWDTB_MERGER
+int is_builtin_dtb(void **fdt_blob)
+{
+	return (*fdt_blob == (void *)ANDES_HW_DTB_ADDRESS);
+}
+#endif
+
 void *board_fdt_blob_setup(int *err)
 {
 	void *fdt_blob = ae350_find_fdt_blob();
@@ -113,7 +120,7 @@ void *board_fdt_blob_setup(int *err)
 	} else {
 		*err = 0;
 #ifdef ANDES_SWDTB_MERGER
-		swdtb_merger_hook_fdtblob(&fdt_blob);
+		swdtb_merger_hook_fdtblob(&fdt_blob, is_builtin_dtb(&fdt_blob));
 #endif
 	}
 
diff --git a/board/andestech/common/swdtb_merger/swdtb_merger.c b/board/andestech/common/swdtb_merger/swdtb_merger.c
index f830d09c864a..be2024ba3db7 100644
--- a/board/andestech/common/swdtb_merger/swdtb_merger.c
+++ b/board/andestech/common/swdtb_merger/swdtb_merger.c
@@ -207,14 +207,28 @@ static int swdtb_find_node(void *fdt)
 /**
  * The main entry of swdtb merger
  * @fdt_blob:	The address for the fdt_blob
+ * @is_hwdtb:	True is using built-in DTB.
  */
-void swdtb_merger(void *fdt_blob)
+void swdtb_merger(void *fdt_blob, int is_hwdtb)
 {
 	/* Cosnsole record for printf message before the serial initial */
 	console_record_init();
 	console_record_reset_enable();
 
-	printf("Using swdtb merger\n");
+	/*
+	 * The SWDTB merger entry is before spl_clear_bss.
+	 * All global variables must be initialized before use.
+	 */
+	swdtb_global_initial();
+
+	printf("Using swdtb merger");
+	if (is_hwdtb) {
+		global_dtb_type = DTB_TYPE_HW_DTB;
+		printf(" for built-in DTB\n");
+	} else {
+		global_dtb_type = DTB_TYPE_USER;
+		printf("\n");
+	}
 
 	if (fdt_magic((void *)fdt_blob) != FDT_MAGIC) {
 		printf("FDT_MAGIC is not match\n");
@@ -224,25 +238,20 @@ void swdtb_merger(void *fdt_blob)
 	/* Increase fdt space */
 	fdt_increase_size(fdt_blob, 2048);
 
-	/*
-	 * The SWDTB merger entry is before spl_clear_bss.
-	 * All global variables must be initialized before use.
-	 */
-	swdtb_global_initial();
-
 	swdtb_find_node(fdt_blob);
 }
 
 /**
  * To hook the original fdt_blob, Use SWDTB_FDTBLOB instead.
  * @fdt_blob:	The pointer to the address of fdt_blob
+ * @is_hwdtb:	True is using built-in DTB.
  */
-void swdtb_merger_hook_fdtblob(void **fdt_blob)
+void swdtb_merger_hook_fdtblob(void **fdt_blob, int is_hwdtb)
 {
 #if CONFIG_IS_ENABLED(RISCV_MMODE)
 	memcpy((void *)SWDTB_FDTBLOB, *fdt_blob, fdt_totalsize(*fdt_blob));
 	*fdt_blob = map_sysmem(SWDTB_FDTBLOB, 0);
-	swdtb_merger((void *)SWDTB_FDTBLOB);
+	swdtb_merger((void *)SWDTB_FDTBLOB, is_hwdtb);
 #endif
 }
 
diff --git a/board/andestech/common/swdtb_merger/swdtb_merger.h b/board/andestech/common/swdtb_merger/swdtb_merger.h
index 988a9ea32144..3bb988934abe 100644
--- a/board/andestech/common/swdtb_merger/swdtb_merger.h
+++ b/board/andestech/common/swdtb_merger/swdtb_merger.h
@@ -22,8 +22,8 @@
 #endif
 #endif
 
-void swdtb_merger(void *source);
-void swdtb_merger_hook_fdtblob(void **fdt_blob);
+void swdtb_merger(void *source, int is_hwdtb);
+void swdtb_merger_hook_fdtblob(void **fdt_blob, int is_hwdtb);
 int swdtb_merger_show_console_record(void);
 
 #endif
