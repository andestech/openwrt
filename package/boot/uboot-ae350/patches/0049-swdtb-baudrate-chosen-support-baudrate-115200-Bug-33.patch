+#if defined(CONFIG_SPL_BUILD) && CONFIG_IS_ENABLED(USE_TINY_PRINTF)
+char *simple_itoa(ulong i)
+{
+	static char local_toa[22];
+	/* 21 digits plus null terminator, good for 64-bit or smaller ints */
+	char *p = &local_toa[21];
+
+	*p-- = '\0';
+	do {
+		*p-- = '0' + i % 10;
+		i /= 10;
+	} while (i > 0);
+	return p + 1;
+}
+#endif
+
+int count_serial_length(const char *serial_string)
+{
+	int count = 0;
+
+	while (isdigit(*serial_string++))
+		++count;
+
+	return count;
+}
+
+char *replace_serial_string(const char *origin_string, int replace_start,
+			    int replace_length, char *new_string,
+			    int new_length)
+{
+	int new_size;
+	char *comb_string;
+
+	/* Add 1 space to copy the \0. */
+	new_size = strlen(origin_string) - replace_length + new_length + 1;
+	comb_string = calloc(1, new_size);
+
+	strncpy(comb_string, origin_string, replace_start);
+	strncpy(comb_string + replace_start, new_string, new_length);
+
+	strncpy(comb_string + replace_start + new_length,
+		origin_string + replace_start + replace_length,
+		strlen(origin_string) - replace_start - replace_length + 1);
+
+	return comb_string;
+}
