+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Configure header file for the swdtb merger for Andes dtb
+ *
+ * Copyright (C) 2024 Andes Technology Corporation
+ */
+#ifndef __SWDTB_CONFIG_H_
+#define __SWDTB_CONFIG_H_
+
+#define ANDES_SWDTB_MERGER_CHECK	1
+
+/* Max string line per bytes for console record */
+#define MAX_STRING_BYTE			256
+
+/*
+ * Before enabling the option ANDES_SWDTB_MERGER_DEBUG_MSG, please increase
+ * the size of CONFIG_CONSOLE_RECORD_OUT_SIZE_F in the defconfig.
+ * It is highly recommended to add at least an additional 0x4000 in size.
+ */
+#define ANDES_SWDTB_MERGER_DEBUG_MSG	0
+#if ANDES_SWDTB_MERGER_DEBUG_MSG
+#define dtb_debug(fmt, args...) do {    \
+	printf("%s(): ", __func__);     \
+	printf(fmt, ##args);            \
+} while (0)
+#else
+#define dtb_debug(fmt, args...)
+#endif
+
+#endif
diff --git a/board/andestech/common/swdtb_merger/swdtb_merger.c b/board/andestech/common/swdtb_merger/swdtb_merger.c
new file mode 100644
index 000000000000..8b6c843f95cf
--- /dev/null
+++ b/board/andestech/common/swdtb_merger/swdtb_merger.c
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * swdtb merger for Andes dtb
+ *
+ * Copyright (C) 2024 Andes Technology Corporation
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <console.h>
+#include <linux/ctype.h>
+#include <linux/libfdt.h>
+#include <fdt.h>
+#include "swdtb_merger.h"
+
+/**
+ * The main entry of swdtb merger
+ * @fdt_blob:	The address for the fdt_blob
+ */
+void swdtb_merger(void *fdt_blob)
+{
+	/* Cosnsole record for printf message before the serial initial */
+	console_record_init();
+	console_record_reset_enable();
+
+	printf("Using swdtb merger\n");
+}
+
+/**
+ * To hook the original fdt_blob, Use SWDTB_FDTBLOB instead.
+ * @fdt_blob:	The pointer to the address of fdt_blob
+ */
+void swdtb_merger_hook_fdtblob(void **fdt_blob)
+{
+#if CONFIG_IS_ENABLED(RISCV_MMODE)
+	memcpy((void *)SWDTB_FDTBLOB, *fdt_blob, fdt_totalsize(*fdt_blob));
+	*fdt_blob = map_sysmem(SWDTB_FDTBLOB, 0);
+	swdtb_merger((void *)SWDTB_FDTBLOB);
+#endif
+}
+
+/**
+ * To show the console record per line
+ * Should only be used after serial is initialized
+ *
+ * Return: 0 on success, or a negative error number
+ */
+int swdtb_merger_show_console_record(void)
+{
+	int ret;
+	char buf[MAX_STRING_BYTE] = { 0 };
+
+	while (1) {
+		/*
+		 * "sizeof(buf) - 5" refers to function fastboot_multiresponse
+		 * in drivers/fastboot
+		 */
+		ret = console_record_readline(buf, sizeof(buf) - 5);
+
+		if (ret > 1) {
+			printf("%s\n", buf);
+		} else if (ret < 0) {
+			printf("error on console_record_readline:%d\n", ret);
+			if (ret == -ENOSPC)
+				printf("please increase CONFIG_CONSOLE_RECORD_OUT_SIZE_F\n");
+			return ret;
+		} else if (*buf == '\0') {
+			/*
+			 * When ret == 1 and buf == '\0', it means we are done.
+			 * When ret == 0 and buf == '\0', it means that the
+			 * console record output mechanism hit an incomplete
+			 * string and then go to error handling.
+			 * In both cases, all of them need to be terminated.
+			 */
+			break;
+		}
+	}
+
+	return 0;
+}
