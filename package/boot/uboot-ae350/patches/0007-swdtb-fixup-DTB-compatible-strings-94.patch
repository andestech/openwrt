+/**
+ * The plicsw_fixup() search the old_str and replace it using new_str
+ * in interrupt-controller@e6400000 node
+ * "riscv,plic1" ==> "andestech,plicsw"
+ *
+ * @return 0 if ok, or FDT_ERR... if not.
+ */
+int plicsw_fixup(void *fdt, int node, char *name, char *value)
+{
+	char *old_str = "riscv,plic1";
+	char *new_str = "andestech,plicsw";
+
+	return compatible_change(fdt, node, name, value, old_str, new_str);
+}
+
+/**
+ * The using_generic_dma() search the old_str and replace it using new_str
+ * in dma@f0c00000 node
+ * "andestech,atcdmac300g" ==> "andestech,atcdmac300"
+ *
+ * @return 0 if ok, or FDT_ERR... if not.
+ */
+int using_generic_dma(void *fdt, int node, char *name, char *value)
+{
+	char *old_str = "andestech,atcdmac300g";
+	char *new_str = "andestech,atcdmac300";
+
+	return compatible_change(fdt, node, name, value, old_str, new_str);
+}
+
+/**
+ * The using_generic_sdc() search the old_str and replace it using new_str
+ * in mmc@f0e00000 node
+ * "andestech,atfsdc010g" ==> "andestech,atfsdc010"
+ *
+ * @return 0 if ok, or FDT_ERR... if not.
+ */
+int using_generic_sdc(void *fdt, int node, char *name, char *value)
+{
+	char *old_str = "andestech,atfsdc010g";
+	char *new_str = "andestech,atfsdc010";
+
+	return compatible_change(fdt, node, name, value, old_str, new_str);
+}
+
+/**
+ * The ae350_fixup() search the old_str and replace it using new_str
+ * in root node
+ * "andestech,ax25" ==> "andestech,ae350"
+ *
+ * @return 0 if ok, or FDT_ERR... if not.
+ */
+int ae350_fixup(void *fdt, int node, char *name, char *value)
+{
+#if defined(CONFIG_ARCH_RV64I)
+	char *old_str = "andestech,ax25";
+#else
+	char *old_str = "andestech,a25";
+#endif
+	char *new_str = "andestech,ae350";
+
+	return compatible_change(fdt, node, name, value, old_str, new_str);
+}
+
+/**
+ * The plmt_fixup() search the old_str and replace it using new_str
+ * in plmt0@e6000000 node
+ * "riscv,plmt0" ==> "andestech,plmt0"
+ *
+ * @return 0 if ok, or FDT_ERR... if not.
+ */
+int plmt_fixup(void *fdt, int node, char *name, char *value)
+{
+	char *old_str = "riscv,plmt0";
+	char *new_str = "andestech,plmt0";
+
+	return compatible_change(fdt, node, name, value, old_str, new_str);
+}
