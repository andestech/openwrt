+int dmad_update_ring(dmad_chreq *ch_req);
+int dmad_update_ring_sw_ptr(dmad_chreq *ch_req,
+				   dma_addr_t sw_ptr, u8 keep_fired);
+dma_addr_t dmad_probe_ring_hw_ptr(dmad_chreq *ch_req);
