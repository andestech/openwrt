+++ b/board/andestech/common/swdtb_merger/swdtb_tool.h
@@ -75,6 +75,8 @@ int compatible_change(void *fdt, int node, char *name, char *value,
 int dma_type_to_node(void *fdt, int node, char *name, const char *target_node);
 int dma_type_fixup(void *fdt, int node, char *name,
 		   char *value, const char *target_node);
+void dma_type_from_mmc_node(void *fdt);
+int find_node_for_gnog(void *fdt, const char *node_nog, const char *node_g);
 
 void show_rawdtb(const char *prop_name, const char *node_name);
 
@@ -82,8 +84,9 @@ void show_rawdtb(const char *prop_name, const char *node_name);
 #define RESULT_STRING	0
 #define RESULT_NUMERAL	1
 void show_result(const void *fdt, int node, const char *prop_name, int type);
+void show_result_multi_num(const void *fdt, int node,
+			   const char *prop_name, int num_count);
 
