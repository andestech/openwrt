diff --git a/board/andestech/common/swdtb_merger/swdtb_merger_fixup.c b/board/andestech/common/swdtb_merger/swdtb_merger_fixup.c
index 0ebea1b93b6e..f26738b8b489 100644
--- a/board/andestech/common/swdtb_merger/swdtb_merger_fixup.c
+++ b/board/andestech/common/swdtb_merger/swdtb_merger_fixup.c
@@ -733,3 +733,39 @@ int dma_global_pool_fixup(void *fdt, int node, char *name, char *value)
 
 	return ret;
 }
+
+/**
+ * The andespmu_event_fixup() will add riscv,raw-event-to-mhpmcounters,
+ * riscv,event-to-mhpmcounters and riscv,event-to-mhpmevent into pmu node,
+ * porting from OpenSBI
+ *
+ * @return 0 if ok, or FDT_ERR... if not.
+ */
+int andespmu_event_fixup(void *fdt, int node, char *name, char *value)
+{
+	const char *target_node = "pmu";
+	const char *cpu_prop = "model";
+	const char *full_name;
+	const char *cpu_mode;
+	const char *cpu_str;
+	unsigned long cpu;
+	int ret;
+
+	full_name = fdt_get_name(fdt, node, NULL);
+	if (strncmp(full_name, target_node, strlen(target_node)) == 0) {
+		cpu_mode = fdt_getprop(fdt, 0, cpu_prop, NULL);
+		if (!cpu_mode) {
+			dtb_error("Not found cpu model\n");
+			return !(RETURN_DONE);
+		}
+		/* Get CPU series number */
+		cpu_str = cpu_mode + (strlen(cpu_mode) - 2);
+		cpu = simple_strtoul(cpu_str, NULL, 10);
+
+		ret = ae350_fdt_add_pmu(fdt, node, cpu);
+
+		return ret;
+	}
+
+	return !(RETURN_DONE);
+}
