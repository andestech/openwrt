+/**
+ * The riscv_isa_fixup() function is used for handling ISA string legacy mode
+ * in Linux 6.6.
+ * 1. remove version numbers of extension:
+ * Example "rv64i2p0m2p0a2p0f2p0d2p0c2p0" ==> "rv64imafdc"
+ * 2. change "xv5-1p1" to "xandes"
+ * 3. change "xdsp0p0" to "xdsp"
+ *
+ * example 1: in AX45MP 4C
+ * "rv64i2p0m2p0a2p0f2p0d2p0c2p0xv5-1p1xdsp0p0" ==>
+ * "rv64imafdc_xandes_xdsp_xandespmu"
+ *
+ * example 2: in AX27L2
+ * "rv64i2p0m2p0a2p0f2p0d2p0c2p0xv5-1p1xdsp0p0" ==>
+ * "rv64imafdc_xandes_xdsp_xandespmu"
+ *
+ * @return 0 if ok, or FDT_ERR... if not.
+ */
+int riscv_isa_fixup(void *fdt, int node, char *name, char *value)
+{
+#define ISA_SUBVERSION_LENGTH	3
+#if defined(CONFIG_ARCH_RV64I)
+	const char *rv_str = "rv64";
+#else
+	const char *rv_str = "rv32";
+#endif
+	const char *xv5_str = "xv5-";
+	const char *old_dsp = "xdsp";
+	const char *new_dsp = "_xdsp";
+
+	const char *prop_name = "riscv,isa";
+	char *old_str = value;
+	int idx = 0;
+	int new_idx = 0;
+	int ret;
+	/*
+	 * Cannot detect the old string, the old string is a
+	 * subset of the new string. 
+	 * 0 is no new_dsp, 1 indicates that it contains new_dsp. 
+	 */
+	int new_dsp_idx = 0;
+	int old_xv5_idx = 0;
+
+	if (strcmp(name, prop_name) == 0) {
+		/* Must using calloc */
+		char *new_str = calloc(1, strlen(old_str));
+
+		if (strstr(old_str, new_dsp)) {
+			/* Contains new "_xdsp" strings. */
+			new_dsp_idx = 1;
+		}
+		if (strstr(old_str, xv5_str)) {
+			/* Contains old "xv5-" strings. */
+			old_xv5_idx = 1;
+		}
+
+		while (idx < strlen(old_str)) {
+			if (!strncmp(&old_str[idx], rv_str, strlen(rv_str))) {
+				strncat(new_str, rv_str, strlen(rv_str));
+
+				idx += strlen(rv_str);
+				new_idx += strlen(rv_str);
+				continue;
+			}
+
+			/*
+			 * Remove subversion phase
+			 * The subversion format is 0p0 1p0 2p0 ....
+			 */
+			if (isdigit(old_str[idx])) {
+				if (old_str[idx + 1] == 'p') {
+					if (isdigit(old_str[idx + 2])) {
+						idx += ISA_SUBVERSION_LENGTH;
+						continue;
+					}
+				}
+			}
+
+			/*
+			 * Remove xv5-1p1, comparison to "xv5-" only
+			 * the subversion of "xv5" will be processed in remove
+			 * subversion phase
+			 */
+			if (old_xv5_idx &&
+			    !strncmp(&old_str[idx],
+				     xv5_str, strlen(xv5_str))) {
+				const char *new_xv5 = "_xandes";
+
+				strncat(new_str, new_xv5, strlen(new_xv5));
+
+				/* Remove xv5-*/
+				idx += strlen(xv5_str);
+				new_idx += strlen(new_xv5);
+				continue;
+			}
+
+			/* Change xdsp to _xdps */
+			if (!new_dsp_idx &&
+			    !strncmp(&old_str[idx],
+				     old_dsp, strlen(old_dsp))) {
+				strncat(new_str, new_dsp, strlen(new_dsp));
+
+				idx += strlen(old_dsp);
+				new_idx += strlen(new_dsp);
+				continue;
+			}
+
+			new_str[new_idx] = old_str[idx];
+			dtb_debug("Current new ISA string: %s\n", new_str);
+
+			idx++;
+			new_idx++;
+		}
+
+		/* Add end flag to new string tail */
+		new_str[new_idx] = '\0';
+		dtb_debug("New string: %s: %s%s%s length:%ld\n",
+			  prop_name, KYEL, new_str, KNRM, strlen(new_str));
+
+		if (strncmp(value, new_str, strlen(new_str)) == 0) {
+			/* Both strings identical */
+			return RETURN_DONE;
+		}
+
+		dtb_info("RAW: %s: %s\n", (char *)name, (char *)value);
+
+		/* The end flag not in the strlen, length +1 is needed */
+		ret = fdt_setprop(fdt, node, name, new_str,
+				  strlen(new_str) + 1);
+		free(new_str);
+		if (ret) {
+			dtb_error("Error on fdt_setprop: %s\n",
+				  fdt_strerror(ret));
+			return ret;
+		}
+
+		ret = andespmu_node_fixup(fdt, node, (char *)prop_name, NULL);
+		if (ret) {
+			dtb_error("Error on fdt_setprop: %s\n",
+				  fdt_strerror(ret));
+			return ret;
+ 		}
+
+		show_result(fdt, node, prop_name, RESULT_STRING);
+
+		return ret;
+	}
+
+	return !(RETURN_DONE);
+}
+
+/**
+ * This is the subfeature of riscv_isa_fixup
+ * for non sscofpmf and 25/27/45 bitmap we will addend _xandespmu to the
+ * isa string
+ * "rv64imafdc" ==> "rv64imafdc_xandespmu"
+ *
+ * @return 0 if ok, or FDT_ERR... if not.
+ */
+int andespmu_node_fixup(void *fdt, int node, char *name, char *value)
+{
+	const char *prop_name = "riscv,isa";
+	/* For non "sscofpmf" bitmap */
+	const char *target_name = "sscofpmf";
+	const char *pmu_isa = "_xandespmu";
+	const char *cpu_prop = "model";
+	const char *cpu_mode;
+	const char *compare_model = "andestech,ax65";
+	const char *old_str;
+	char *new_str;
+	int ret;
+
+	old_str = fdt_getprop(fdt, node, prop_name, NULL);
+
+	/* The "sscofpmf" is the major string in this fixup, check first. */
+	if (strstr(old_str, target_name)) {
+		/* Already contains "sscofpmf" strings. */
+		return RETURN_DONE;
+	}
+
+	/* The "_xandespmu" is the major string in this fixup, check first. */
+	if (strstr(old_str, pmu_isa)) {
+		/* Already contains "_xandespmu" strings. */
+		return RETURN_DONE;
+	}
+
+	cpu_mode = fdt_getprop(fdt, 0, cpu_prop, NULL);
+	if (!cpu_mode) {
+		printf("Not found cpu model\n");
+		return !(RETURN_DONE);
+	}
+
+	/* The bitmap cpu is not 25 27 45 */
+	if (strcmp(cpu_mode, compare_model) == 0) {
+		/* The bitmap is ax65 we don't need to add xandespmu for ax65 */
+		printf("CPU is %s\n", compare_model);
+		return RETURN_DONE;
+	}
+
+	/* Must using calloc */
+	new_str = calloc(1, strlen(old_str) + strlen(pmu_isa) + 1);
+	strncat(new_str, old_str, strlen(old_str));
+	/* +1 for '\0' */
+	strncat(new_str, pmu_isa, strlen(pmu_isa) + 1);
+
+	/* The end flag not in the strlen, length +1 is needed */
+	ret = fdt_setprop(fdt, node, name, new_str,
+			  strlen(new_str) + 1);
+	if (ret)
+		dtb_error("Error on fdt_setprop: %s\n", fdt_strerror(ret));
+
+	free(new_str);
+
+	return ret;
+}
