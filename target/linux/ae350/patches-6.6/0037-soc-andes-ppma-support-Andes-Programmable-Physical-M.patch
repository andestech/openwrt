diff --git a/drivers/soc/andes/Kconfig b/drivers/soc/andes/Kconfig
new file mode 100644
index 000000000000..2dd6443f5a5f
--- /dev/null
+++ b/drivers/soc/andes/Kconfig
@@ -0,0 +1,14 @@
+# SPDX-License-Identifier: GPL-2.0
+menu "Andes AE350 platform drivers"
+
+config ANDES_PPMA
+	bool "Andes PPMA Support"
+	depends on ARCH_ANDES
+	depends on ERRATA_ANDES
+	depends on ERRATA_ANDES_CMO
+	help
+	  When calling memremap with MEMREMAP_WC flag,
+	  Andes programmable physical memory attributes (PPMA)
+	  can map memory as non-cacheable bufferable PMA region.
+
+endmenu
diff --git a/drivers/soc/andes/Makefile b/drivers/soc/andes/Makefile
new file mode 100644
index 000000000000..fc25ab9c031f
--- /dev/null
+++ b/drivers/soc/andes/Makefile
@@ -0,0 +1,5 @@
+# SPDX-License-Identifier: GPL-2.0
+# Copyright (C) 2023 Andes Technology Corporation.
+
+obj-y	+= andes_sbi.o
