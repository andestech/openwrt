+
+int show_reserved_memory_node(const void *fdt, int node,
+			      const char *compatible)
+{
+#ifdef ANDES_SWDTB_MERGER_CHECK
+	struct fdt_memory carveout;
+	fdt_size_t size;
+
+	const struct fdt_node_header *nh =
+		fdt_offset_ptr_(fdt, node);
+	printf("Result: %s: %s %s %s\n",
+	       compatible, KYEL, nh->name, KNRM);
+
+	carveout.start =
+		fdtdec_get_addr_size_auto_noparent(fdt, node,
+						   "reg", 0, &size,
+						   true);
+	if (carveout.start == FDT_ADDR_T_NONE) {
+		dtb_debug("failed to read address/size from \"reg\" property\n");
+		return -FDT_ERR_NOTFOUND;
+	}
+
+	carveout.end = carveout.start + size - 1;
+
+	printf("Reserved %s0x%lx%s ~ %s0x%lx%s\n",
+	       KYEL, (unsigned long)carveout.start, KNRM,
+	       KYEL, (unsigned long)carveout.end, KNRM);
+
+	return RETURN_DONE;
+#endif
+}
