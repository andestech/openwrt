 	const char *target_node = "mmc";
 	const char *dma_names = "dma-names";
 	const char *dma_rxtx = "rxtx";
-	const char *full_name;
 	int ret;
 
-	full_name = fdt_get_name(fdt, node, NULL);
-	if (strncmp(full_name, target_node, strlen(target_node)) == 0) {
+	if (fdt_node_name_cmp(fdt, node, target_node)) {
 		const u32 *value;
 
 		value = fdt_getprop(fdt, node, dma_names, NULL);
@@ -839,14 +826,12 @@ int mmc_dma_rxtx_fixup(void *fdt, int node, char *name, char *value)
 int mmc_dma_dmas_fixup(void *fdt, int node, char *name, char *value)
 {
 	const char *target_node = "mmc";
-	const char *full_name;
 	struct dmas dmas_array[1];
 
 	/* The even indices of the array store the DMA's phandle. */
 	dmas_array[0].handshake_id = cpu_to_fdt32(DMA_HANDSHAKE_ID_MMC);
 
-	full_name = fdt_get_name(fdt, node, NULL);
-	if (strncmp(full_name, target_node, strlen(target_node)) == 0) {
+	if (fdt_node_name_cmp(fdt, node, target_node)) {
 		return dma_set_dmas_array(fdt, node, dmas_array,
 					  ARRAY_SIZE(dmas_array));
 	}
@@ -864,11 +849,9 @@ int dma_cells_fixup(void *fdt, int node, char *name, char *value)
 	const char *target_node = "dma";
 	const char *dma_cells = "#dma-cells";
 	const u32 cells_value = 1;
-	const char *full_name;
 	int ret;
 
-	full_name = fdt_get_name(fdt, node, NULL);
-	if (strncmp(full_name, target_node, strlen(target_node)) == 0) {
+	if (fdt_node_name_cmp(fdt, node, target_node)) {
 		const u32 *value;
 
 		value = fdt_getprop(fdt, node, dma_cells, NULL);
@@ -1135,11 +1118,9 @@ int spi_dma_rxtx_fixup(void *fdt, int node, char *name, char *value)
 	const char *dma_names = "dma-names";
 	const char *dma_spi_tx = "spi_tx";
 	const char *dma_spi_rx = "spi_rx";
-	const char *full_name;
 	int ret;
 
-	full_name = fdt_get_name(fdt, node, NULL);
-	if (strncmp(full_name, target_node, strlen(target_node)) == 0) {
+	if (fdt_node_name_cmp(fdt, node, target_node)) {
 		const u32 *value;
 
 		value = fdt_getprop(fdt, node, dma_names, NULL);
@@ -1182,15 +1163,13 @@ int spi_dma_rxtx_fixup(void *fdt, int node, char *name, char *value)
 int spi_dma_dmas_fixup(void *fdt, int node, char *name, char *value)
 {
 	const char *target_node = "spi";
-	const char *full_name;
 	struct dmas dmas_array[2];
 
 	/* The even indices of the array store the DMA's phandle. */
 	dmas_array[0].handshake_id = cpu_to_fdt32(DMA_HANDSHAKE_ID_SPI_TX);
 	dmas_array[1].handshake_id = cpu_to_fdt32(DMA_HANDSHAKE_ID_SPI_RX);
 
-	full_name = fdt_get_name(fdt, node, NULL);
-	if (strncmp(full_name, target_node, strlen(target_node)) == 0) {
+	if (fdt_node_name_cmp(fdt, node, target_node)) {
 		return dma_set_dmas_array(fdt, node, dmas_array,
 					  ARRAY_SIZE(dmas_array));
 	}
diff --git a/board/andestech/common/swdtb_merger/swdtb_tool.c b/board/andestech/common/swdtb_merger/swdtb_tool.c
index 52ba1955f18b..374321a257bf 100644
--- a/board/andestech/common/swdtb_merger/swdtb_tool.c
+++ b/board/andestech/common/swdtb_merger/swdtb_tool.c
@@ -294,16 +294,9 @@ int show_reserved_memory_node(const void *fdt, int node,
 int dma_type_fixup(void *fdt, int node, char *name,
 		   char *value, const char *target_node)
 {
-	const char *full_name;
-	int length = strlen(target_node);
-	int ret;
+	if (fdt_node_name_cmp(fdt, node, target_node))
+		return dma_type_to_node(fdt, node, name, target_node);
 
-	full_name = fdt_get_name(fdt, node, NULL);
-	if (strncmp(full_name, target_node, length) == 0 &&
-	    full_name[length] == '@') {
-		ret = dma_type_to_node(fdt, node, name, target_node);
-		return ret;
-	}
 	return !(RETURN_DONE);
 }
 
@@ -403,3 +396,18 @@ char *replace_serial_string(const char *origin_string, int replace_start,
 
 	return comb_string;
 }
+
+int fdt_node_name_cmp(const void *fdt, int node, const char *target_node)
+{
+	const char *full_name;
+	int length;
+
+	length = strlen(target_node);
+	full_name = fdt_get_name(fdt, node, NULL);
+
+	if (strncmp(full_name, target_node, length) == 0 &&
+	    (full_name[length] == '@' || full_name[length] == '\0'))
+		return 1;
+	else
+		return 0;
+}
