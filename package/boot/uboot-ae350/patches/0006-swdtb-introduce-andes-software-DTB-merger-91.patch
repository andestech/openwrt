+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Header file for the swdtb merger for Andes dtb
+ *
+ * Copyright (C) 2024 Andes Technology Corporation
+ */
+#ifndef __SWDTB_MERGER_H_
+#define __SWDTB_MERGER_H_
+#include <mapmem.h>
+#include "swdtb_config.h"
+
+#if CONFIG_VAL(PAYLOAD_ARGS_ADDR)
+#define SWDTB_FDTBLOB	(CONFIG_SPL_PAYLOAD_ARGS_ADDR)
+#else
+#if CONFIG_IS_ENABLED(LOAD_FIT) || CONFIG_IS_ENABLED(LOAD_FIT_FULL)
+#if (CONFIG_TEXT_BASE < 0x100000)
+#error CONFIG_TEXT_BASE needs to be larger than 0x100000
+#endif
+#define SWDTB_FDTBLOB	(CONFIG_TEXT_BASE - 0x100000)
+#endif
+#endif
+
+void swdtb_merger(void *source);
+void swdtb_merger_hook_fdtblob(void **fdt_blob);
+int swdtb_merger_show_console_record(void);
+
+#endif
