 	dma_cookie_t		cookie;
-	unsigned long		flags;
 
-	spin_lock_irqsave(&v5chan->lock, flags);
+	spin_lock_bh(&v5chan->lock);
 	cookie = dma_cookie_assign(tx);
 	list_add_tail(&desc->desc_node, &v5chan->queue);
-	spin_unlock_irqrestore(&v5chan->lock, flags);
+	spin_unlock_bh(&v5chan->lock);
 
