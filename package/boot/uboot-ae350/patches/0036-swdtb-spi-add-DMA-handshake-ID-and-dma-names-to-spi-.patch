--- a/board/andestech/common/swdtb_merger/swdtb_merger.c
+++ b/board/andestech/common/swdtb_merger/swdtb_merger.c
@@ -61,6 +61,10 @@ struct swdtb_table dtb_merge_table[] = {
 	 "add dma cell",		dma_cells_fixup},
 	{SWDTB_ENABLE,	1,
 	 "fix uart baud rate",		uart_baudrate_fixup},
+	{SWDTB_ENABLE,	1,
+	 "add dma spi_tx spi_rx",	spi_dma_rxtx_fixup},
+	{SWDTB_ENABLE,	1,
+	 "add dmas to spi",		spi_dma_dmas_fixup},
 };
 
 /*
@@ -246,7 +250,7 @@ void swdtb_merger(void *fdt_blob, int is_hwdtb)
 	}
 
 	/* Increase fdt space */
-	fdt_increase_size(fdt_blob, 2048);
+	fdt_increase_size(fdt_blob, 4096);
 
 	swdtb_find_node(fdt_blob);
 }
