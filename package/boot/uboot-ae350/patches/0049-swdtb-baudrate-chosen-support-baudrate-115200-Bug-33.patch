 	return RETURN_DONE;
 }
 
+int search_serial_index_size(const char *origin_string, int *index,
+			     const char *baudrate)
+{
+	char *token;
+	char *bootargs_token;
+	const char *split_char = " ";
+	char *serial_str;
+	int replace_length;
+
+	/*
+	 * In this context, strndup calls malloc and strncpy,
+	 * performing a "full copy" of the entire string size.
+	 * This is why we don't use memset for the duplicated string.
+	 */
+	bootargs_token = strdup(origin_string);
+
+	token = strtok(bootargs_token, split_char);
+	while (token) {
+		if (strstr(token, "console") &&
+		    strstr(token, ",")) {
+			break;
+		}
+		token = strtok(NULL, split_char);
+	}
+	/* The first character is "," skip by add 1 */
+	serial_str = strstr(token, ",") + 1;
+
+	replace_length = count_serial_length(serial_str);
+
+	if (replace_length > 0 &&
+	    strncmp(serial_str, baudrate, strlen(baudrate)) == 0) {
+		replace_length = 0;
+		goto out;
+	}
+
+	*index = serial_str - bootargs_token;
+
+out:
+	free(bootargs_token);
+	return replace_length;
+}
+
+int bootargs_baudrate_fixup(void *fdt, int node, char *name, char *value)
+{
+	const char *prop_name = "bootargs";
+	const char *config_baudrate = simple_itoa(CONFIG_BAUDRATE);
+	const char *bootargs;
+	int replace_length;
+	int replace_idx;
+	char *new_baudrate;
+	int ret;
+
+	if (strncmp(name, prop_name, strlen(prop_name)) == 0) {
+		bootargs = fdt_getprop(fdt, node, prop_name, NULL);
+		replace_length = search_serial_index_size(bootargs,
+							  &replace_idx,
+							  config_baudrate);
+		if (replace_length == 0)
+			return RETURN_DONE;
+
+		dtb_info("Node: %s, %s: %s\n",
+			 fdt_get_name(fdt, node, NULL),
+			 prop_name, bootargs);
+
+		new_baudrate = replace_serial_string(bootargs,
+						     replace_idx,
+						     replace_length,
+						     config_baudrate,
+						     strlen(config_baudrate));
+		/* The end flag not in the strlen, length +1 is needed */
+		ret = fdt_setprop(fdt, node, prop_name, new_baudrate,
+				  strlen(new_baudrate) + 1);
+		free(new_baudrate);
+		if (ret) {
+			dtb_error("Error on fdt_setprop: %s\n",
+				  fdt_strerror(ret));
+			return ret;
+		}
+
+		show_result(fdt, node, prop_name, RESULT_STRING);
+
+		return RETURN_DONE;
+	}
+
+	return !(RETURN_DONE);
+}
+
+int stdout_baudrate_fixup(void *fdt, int node, char *name, char *value)
+{
+	const char *prop_stdout = "stdout-path";
+	const char *config_baudrate = simple_itoa(CONFIG_BAUDRATE);
+	const char *stdout_path;
+	char *stdout_parameter;
+	int replace_length;
+	int replace_idx;
+	char *new_baudrate;
+	int ret;
+
+	if (strncmp(name, prop_stdout, strlen(prop_stdout)) == 0) {
+		/* The stdout-path have already correct */
+		stdout_path = fdt_getprop(fdt, node, prop_stdout, NULL);
+		if (strstr(stdout_path, config_baudrate))
+			return RETURN_DONE;
+
+		/* The stdout-path using full path mode */
+		stdout_parameter = strchr(stdout_path, ':');
+		if (!stdout_parameter)
+			return RETURN_DONE;
+
+		dtb_info("Node: %s, %s: %s\n", fdt_get_name(fdt, node, NULL),
+			 prop_stdout, stdout_path);
+
+		/* The first character is ":" skip by set idx = 1 */
+		stdout_parameter += 1;
+		replace_length = count_serial_length(stdout_parameter);
+
+		replace_idx = stdout_parameter - stdout_path;
+
+		new_baudrate = replace_serial_string(stdout_path,
+						     replace_idx,
+						     replace_length,
+						     config_baudrate,
+						     strlen(config_baudrate));
+
+		/* The end flag not in the strlen, length +1 is needed */
+		ret = fdt_setprop(fdt, node, prop_stdout, new_baudrate,
+				  strlen(new_baudrate) + 1);
+		free(new_baudrate);
+		if (ret) {
+			dtb_error("Error on fdt_setprop: %s\n",
+				  fdt_strerror(ret));
+			return ret;
+		}
+
+		show_result(fdt, node, prop_stdout, RESULT_STRING);
+
+		return RETURN_DONE;
+	}
+
+	return !(RETURN_DONE);
+}
