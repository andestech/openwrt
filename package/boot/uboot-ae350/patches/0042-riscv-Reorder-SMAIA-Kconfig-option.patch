From d8b9ec7626db209ed22d1d8663157ff8dc025a3c Mon Sep 17 00:00:00 2001
From: Leo Yu-Chi Liang <ycliang@andestech.com>
Date: Thu, 2 Jan 2025 13:55:31 +0800
Subject: [PATCH 42/53] riscv: Reorder SMAIA Kconfig option

Signed-off-by: Leo Yu-Chi Liang <ycliang@andestech.com>
---
 arch/riscv/Kconfig | 36 ++++++++++++++++++------------------
 1 file changed, 18 insertions(+), 18 deletions(-)

diff --git a/arch/riscv/Kconfig b/arch/riscv/Kconfig
index 367079ed7f35..85e515e3e75f 100644
--- a/arch/riscv/Kconfig
+++ b/arch/riscv/Kconfig
@@ -225,24 +225,6 @@ config RISCV_ISA_ZBB
 	  of bit-specific operations (count bit population, sign extending,
 	  bitrotation, etc) and enables optimized string routines.
 
-config SPL_RISCV_ISA_SMAIA
-	bool "Smaia extension support advanced interrupt architecture"
-	depends on SPL_RISCV_MMODE
-	default y
-	help
-	  The Smaia extension encompasses all added CSRs and all modifications
-	  to interrupt response behavior that the AIA specifies for a hart, over
-	  all privilege levels.
-
-config RISCV_ISA_SMAIA
-	bool "Smaia extension support advanced interrupt architecture"
-	depends on RISCV_MMODE
-	default y
-	help
-	  The Smaia extension encompasses all added CSRs and all modifications
-	  to interrupt response behavior that the AIA specifies for a hart, over
-	  all privilege levels.
-
 menu "Use assembly optimized implementation of string routines"
 
 config USE_ARCH_STRLEN
@@ -325,6 +307,24 @@ config TPL_USE_ARCH_STRNCMP
 
 endmenu
 
+config SPL_RISCV_ISA_SMAIA
+	bool "Smaia extension support advanced interrupt architecture"
+	depends on SPL_RISCV_MMODE
+	default y
+	help
+	  The Smaia extension encompasses all added CSRs and all modifications
+	  to interrupt response behavior that the AIA specifies for a hart, over
+	  all privilege levels.
+
+config RISCV_ISA_SMAIA
+	bool "Smaia extension support advanced interrupt architecture"
+	depends on RISCV_MMODE
+	default y
+	help
+	  The Smaia extension encompasses all added CSRs and all modifications
+	  to interrupt response behavior that the AIA specifies for a hart, over
+	  all privilege levels.
+
 config RISCV_ISA_A
 	def_bool y
 
-- 
2.34.1

