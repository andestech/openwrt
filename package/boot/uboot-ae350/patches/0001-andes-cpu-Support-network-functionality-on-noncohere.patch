diff --git a/arch/riscv/cpu/andes/noncache.c b/arch/riscv/cpu/andes/noncache.c
new file mode 100644
index 000000000000..c9855e9c8b5a
--- /dev/null
+++ b/arch/riscv/cpu/andes/noncache.c
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2024 Andes Technology Corporation
+ * Rick Chen, Andes Technology Corporation <rick@andestech.com>
+ * Leo Liang, Andes Technology Corporation <ycliang@andestech.com>
+ *
+ * An noncacheable memory region is created through noncached_init,
+ * managed by noncached_alloc, and freed by noncached_free
+ * for AE350 platform to support noncoherent bitmap.
+ */
+
+#include <asm/csr.h>
+#include <asm/encoding.h>
+#include <asm/sbi.h>
+#include <common.h>
+#include <cpu_func.h>
+#include <malloc.h>
+#include <linux/log2.h>
+
+#ifdef CONFIG_SYS_NONCACHED_MEMORY
+
+#ifdef CONFIG_32BIT
+#define SATP_PPN	_AC(0x003FFFFF, UL)
+#else
+#define SATP_PPN	_AC(0x00000FFFFFFFFFFF, UL)
+#endif
+
+static unsigned long noncached_start = 0;
+static unsigned long noncached_end = 0;
+static unsigned long noncached_next = 0;
+static unsigned long andes_pa_msb = 0;
+
+int noncached_init(void)
+{
+	phys_addr_t start, end;
+	size_t size;
+
+	end = ALIGN(mem_malloc_start, MMU_SECTION_SIZE) - MMU_SECTION_SIZE;
+	size = ALIGN(CONFIG_SYS_NONCACHED_MEMORY, MMU_SECTION_SIZE);
+	start = end - size;
+	debug("mapping memory %pa-%pa non-cached\n", &start, &end);
+
+	noncached_start = start;
+	noncached_end = end;
+	noncached_next = start;
+
+	if (sbi_pma_probe()){
+		sbi_pma_set(start, start, size);
+	} else {
+		csr_write(CSR_SATP, SATP_PPN);
+		andes_pa_msb = (csr_read(CSR_SATP) + 1) >> 1;
+	}
+
+	return 0;
+}
+
+phys_addr_t noncached_alloc(size_t size, size_t align)
+{
+	phys_addr_t next = ALIGN(noncached_next, align);
+	size = __roundup_pow_of_two(size);
+
+	if (next >= noncached_end || (noncached_end - next) < size)
+		return 0;
+
+	debug("allocated %zu bytes of uncached memory @%pa\n", size, &next);
+	noncached_next = next + size;
+
+	return (next | (andes_pa_msb << 12));
+}
+
+void noncached_free(void)
+{
+	sbi_pma_free(noncached_start);
+}
+
+#endif /* CONFIG_SYS_NONCACHED_MEMORY */
