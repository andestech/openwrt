@@ -55,8 +55,15 @@ int dma_global_pool_fixup(void *fdt, int node, char *name, char *value);
 
 int andespmu_event_fixup(void *fdt, int node, char *name, char *value);
 
+#define DMA_HANDSHAKE_ID_SPI_TX	0x0
+#define DMA_HANDSHAKE_ID_SPI_RX	0x1
+#define DMA_HANDSHAKE_ID_MMC	0x9
+
 int mmc_dma_rxtx_fixup(void *fdt, int node, char *name, char *value);
 int mmc_dma_dmas_fixup(void *fdt, int node, char *name, char *value);
+int spi_dma_rxtx_fixup(void *fdt, int node, char *name, char *value);
+int spi_dma_dmas_fixup(void *fdt, int node, char *name, char *value);
 int dma_cells_fixup(void *fdt, int node, char *name, char *value);
+
 int uart_baudrate_fixup(void *fdt, int node, char *name, char *value);
 #endif
diff --git a/board/andestech/common/swdtb_merger/swdtb_tool.c b/board/andestech/common/swdtb_merger/swdtb_tool.c
index 8c097b365700..8dddc13b8c04 100644
--- a/board/andestech/common/swdtb_merger/swdtb_tool.c
+++ b/board/andestech/common/swdtb_merger/swdtb_tool.c
@@ -147,6 +147,15 @@ int dma_type_to_node(void *fdt, int node, char *name, const char *target_node)
 	return ret;
 }
 
+/*
+ * Find the DMA node by the compatible string, regardless of whether
+ * it ends with 'g' or not. To disregard the order of modification in
+ * DMA/MMC node compatible strings, it will search for both strings and
+ * return the appropriate one.
+ *
+ * Example_1: andestech,atfsdc010g or andestech,atfsdc010
+ * Example_2: andestech,atcdmac300g or aandestech,atcdmac300
+ */
 int find_node_for_gnog(void *fdt, const char *node_nog, const char *node_g)
 {
 	int offset_nog;
@@ -206,7 +215,7 @@ void show_result(const void *fdt, int node, const char *prop_name, int type)
 		dtb_error("Error on fdt_getprop\n");
 
 	if (type == RESULT_STRING) {
-		/* The data is of string type; just display it. */		
+		/* The data is of string type; just display it. */
 		count = fdt_stringlist_count(fdt, node, prop_name);
 
 		if (count == 1) {
@@ -242,7 +251,8 @@ void show_result_multi_num(const void *fdt, int node,
 	if (!data)
 		dtb_error("Error on fdt_getprop\n");
 
-	printf("Result: %s: %s", prop_name, KYEL);
+	printf("Result: %s in %s: %s",
+	       prop_name, fdt_get_name(fdt, node, NULL), KYEL);
 	for(idx = 0; idx < num_count; idx++) {
 		printf("%d ", fdt32_to_cpu(*((u32 *)data + idx)));
 	}
@@ -296,3 +306,53 @@ int dma_type_fixup(void *fdt, int node, char *name,
 	}
 	return !(RETURN_DONE);
 }
+
+int dma_set_dmas_array(void *fdt, int node, struct dmas *arr, int arr_sz)
+{
+	const char *dmas = "dmas";
+	const char *dma_compat = "andestech,atcdmac300";
+	const char *dma_compat_g = "andestech,atcdmac300g";
+	const u32 *value;
+	int dmanode;
+	int dma_phandle;
+	int ret;
+	int idx;
+	int total_size;
+	int count_fdt32;
+
+	value = fdt_getprop(fdt, node, dmas, NULL);
+	if (value)
+		return RETURN_DONE;
+
+	dmanode = find_node_for_gnog(fdt, dma_compat, dma_compat_g);
+	if (dmanode <= 0)
+		return dmanode;
+
+	dma_phandle = fdt_get_phandle(fdt, dmanode);
+	if (!dma_phandle) {
+		dma_phandle = fdt_create_phandle(fdt, dmanode);
+		if (!dma_phandle) {
+			dtb_error("Error on fdt_get_phandle: %s\n",
+				  fdt_strerror(dma_phandle));
+			return dma_phandle;
+		}
+	}
+
+	for (idx = 0; idx < arr_sz; idx++) {
+		/* Only even indices store the DMA's phandle */
+		arr[idx].phandle = cpu_to_fdt32(dma_phandle);
+	}
+
+	total_size = arr_sz * sizeof(struct dmas);
+	count_fdt32 = total_size / sizeof(fdt32_t);
+
+	ret = fdt_appendprop(fdt, node, dmas, arr, total_size);
+	if (ret) {
+		printf("fdt_appendprop: err=%s\n", fdt_strerror(ret));
+		return ret;
+	}
+
+	show_result_multi_num(fdt, node, dmas, count_fdt32);
+
+	return ret;
+}
