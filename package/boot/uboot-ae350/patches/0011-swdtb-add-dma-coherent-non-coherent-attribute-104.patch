 #include "swdtb_tool.h"
 
+/*
+ * The SWDTB merger entry precedes spl_clear_bss.
+ * All global variables must be initialized before use.
+ */
+enum dma_type global_dma_type;
+
+void swdtb_global_initial(void)
+{
+	/*
+	 * All global variables will be reset in spl_clear_bss.
+	 * Please note the life of these variables.
+	 */
+	global_dma_type = DMA_TYPE_INIT;
+}
