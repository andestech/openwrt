 bool fdt_data_is_one_string(const char *data, int len)
 {
 	return ((len > 0) && (strnlen(data, len) == len - 1));
@@ -48,6 +63,74 @@ void show_rawdtb(const char *prop_name, const char *node_name)
 	dtb_info("No %s in %s\n", prop_name, node_name);
 }
 
+/*
+ * This fixup will search dma-coherent and dma-noncoherent in the dtb
+ * and set the coherent/noncoherent to global variable
+ * finally, set the global variable to the target node.
+ */
+int dma_type_to_node(void *fdt, int node, char *name, const char *target_node)
+{
+	const char *target_1 = "dma-coherent";
+	const char *target_2 = "dma-noncoherent";
+	const char *target;
+	const u32 *value;
+	int ret;
+
+	value = fdt_getprop(fdt, node, target_1, NULL);
+	if (value) {
+		/* Find the result */
+		dtb_debug("Find %s in %s\n", target_1, target_node);
+		return RETURN_DONE;
+	}
+
+	value = fdt_getprop(fdt, node, target_2, NULL);
+	if (value) {
+		/* Find the result */
+		dtb_debug("Find %s in %s\n", target_2, target_node);
+		return RETURN_DONE;
+	}
+
+	show_rawdtb(target_1, target_node);
+	show_rawdtb(target_2, target_node);
+
+	/* find global dma type coherent / noncoherent type */
+	if (global_dma_type == DMA_TYPE_INIT) {
+		const u32 *target_1_idx;
+
+		target_1_idx = fdt_getprop(fdt, 0, target_1, NULL);
+		if (target_1_idx) {
+			global_dma_type = DMA_TYPE_COHERENT;
+			printf("Bitmap's DMA type is %s\n", target_1);
+		} else {
+			global_dma_type = DMA_TYPE_NONCOHERENT;
+			printf("Bitmap's DMA type is %s\n", target_2);
+		}
+	}
+
+	if (global_dma_type == DMA_TYPE_COHERENT)
+		target = target_1;
+	else if (global_dma_type == DMA_TYPE_NONCOHERENT)
+		target = target_2;
+
+	ret = fdt_setprop_empty(fdt, node, target);
+	if (ret) {
+		printf("error on fdt_setprop_empty: %s\n",
+		       fdt_strerror(ret));
+		return ret;
+	}
+
+#ifdef ANDES_SWDTB_MERGER_CHECK
+	value = fdt_getprop(fdt, node, target, NULL);
+	if (value) {
+		/* Find the result */
+		printf("Result: %s%s%s in %s%s%s\n",
+		       KYEL, target, KNRM, KYEL, target_node, KNRM);
+	}
+#endif
+
+	return ret;
+}
+
 void show_result(const void *fdt, int node, const char *prop_name, int type)
 {
 #ifdef ANDES_SWDTB_MERGER_CHECK
diff --git a/board/andestech/common/swdtb_merger/swdtb_tool.h b/board/andestech/common/swdtb_merger/swdtb_tool.h
