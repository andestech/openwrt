From ef1b9ad6d3bb13edf4cff96d4659056e76ba54d1 Mon Sep 17 00:00:00 2001
From: charles <dminus@andestech.com>
Date: Fri, 26 Apr 2024 13:28:15 +0800
Subject: [PATCH 037/168] soc: andes: ppma: support Andes Programmable Physical
 Memory Attribute (PPMA)

If the device want a non-cacheable memory region, it calls
ioremap_wc() to get a VA which maps to non-cacheable memory region.
The CONFIG_ANDES_PPMA must be set.

Reformed from the following patches on RISCV-Linux-5.4:
- riscv: Support PMA(Physical Memory Attribute) on linux5.4.
- FTLCD100: Fix ioremap_nocache() causing LCD kernel panic issue.
- Complete the programmable PMA implementation with IPI
- Fix compilation error for (884f011d)
- andes: rename sbi calls of andes vendor extension
- riscv: fix compilation warnings
- RISC-V: skip PMA setting for non-memory region

Reformed from the following patches on RISCV-Linux-6.1:
- soc: andes: ppma: support Andes PPMA(Programmable Physical Memory
  Attribute) in Linux 6.1
- soc: andes: ppma: Support IPI in andes_free_ppma()
- soc: andes: ppma: fix complier error when disable ppma
- soc: andes: ppma:Replacing smp_processor_id() with get/put_cpu()
  for preemption control

Signed-off-by: charles <dminus@andestech.com>
---
 arch/riscv/configs/andes-support.config |  1 +
 arch/riscv/errata/andes/errata.c        |  4 +
 arch/riscv/mm/ioremap.c                 |  8 ++
 drivers/soc/Kconfig                     |  1 +
 drivers/soc/Makefile                    |  1 +
 drivers/soc/andes/Kconfig               | 14 ++++
 drivers/soc/andes/Makefile              |  5 ++
 drivers/soc/andes/andes_sbi.c           | 31 ++++++++
 drivers/soc/andes/ppma.c                | 98 +++++++++++++++++++++++++
 include/linux/soc/andes/ppma.h          | 35 +++++++++
 include/linux/soc/andes/sbi.h           |  6 ++
 11 files changed, 204 insertions(+)
 create mode 100644 drivers/soc/andes/Kconfig
 create mode 100644 drivers/soc/andes/Makefile
 create mode 100644 drivers/soc/andes/andes_sbi.c
 create mode 100644 drivers/soc/andes/ppma.c
 create mode 100644 include/linux/soc/andes/ppma.h

diff --git a/arch/riscv/configs/andes-support.config b/arch/riscv/configs/andes-support.config
index 376591a30097..6f0473c95dd0 100644
--- a/arch/riscv/configs/andes-support.config
+++ b/arch/riscv/configs/andes-support.config
@@ -1,2 +1,3 @@
 CONFIG_DEFAULT_HOSTNAME="andes-test"
 CONFIG_ARCH_ANDES=y
+CONFIG_ANDES_PPMA=y
diff --git a/arch/riscv/errata/andes/errata.c b/arch/riscv/errata/andes/errata.c
index 779f9a6eefe3..932757c9b112 100644
--- a/arch/riscv/errata/andes/errata.c
+++ b/arch/riscv/errata/andes/errata.c
@@ -18,6 +18,7 @@
 #include <asm/vendorid_list.h>
 #include <linux/soc/andes/sbi.h>
 #include <linux/soc/andes/andes.h>
+#include <linux/soc/andes/ppma.h>
 
 #define ANDES_AX45MP_MARCHID		0x8000000000008a45UL
 #define ANDES_AX45MP_MIMPID		0x500UL
@@ -107,6 +108,9 @@ static bool errata_support_uncache(unsigned int stage,
 	riscv_cbom_block_size = 1;
 	riscv_noncoherent_supported();
 
+	if (andes_probe_ppma())
+		return true;
+
 	csr_write(satp, SATP_PPN);
 	andes_pfn_msb = (csr_read(satp) + 1) >> 1;
 
diff --git a/arch/riscv/mm/ioremap.c b/arch/riscv/mm/ioremap.c
index 6347fc6c9d76..4e00d2fa979d 100644
--- a/arch/riscv/mm/ioremap.c
+++ b/arch/riscv/mm/ioremap.c
@@ -6,6 +6,8 @@
 #include <linux/export.h>
 #include <linux/io.h>
 #include <linux/pgtable.h>
+#include <linux/soc/andes/andes.h>
+#include <linux/soc/andes/ppma.h>
 
 void __iomem *ioremap_wc(phys_addr_t phys_addr, size_t size)
 {
@@ -16,12 +18,18 @@ void __iomem *ioremap_wc(phys_addr_t phys_addr, size_t size)
 
 	ret = ioremap_prot(phys_addr, size, pgprot_val(prot));
 
+	if (ret && !andes_pfn_msb)
+		andes_set_ppma(phys_addr, ret, size);
+
 	return ret;
 }
 EXPORT_SYMBOL(ioremap_wc);
 
 void iounmap(volatile void __iomem *addr)
 {
+	if (!andes_pfn_msb)
+		andes_free_ppma((void *)addr);
+
 	generic_iounmap(addr);
 }
 EXPORT_SYMBOL(iounmap);
