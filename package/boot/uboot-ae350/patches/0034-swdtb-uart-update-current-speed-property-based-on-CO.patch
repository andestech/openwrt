+/**
+ * uart_baudrate_fixup() modifies or adds the `current-speed` property
+ * to all UART nodes in the DTS using the CONFIG_BAUDRATE value.
+ *
+ * DTS:
+ *   serial@f0300000 {
+ *     compatible = "andestech,uart16550\0ns16550a";
+ *     reg = <0x00 0xf0300000 0x00 0x1000>;
+ *     interrupts = <0x09 0x04>;
+ *     interrupt-parent = <0x03>;
+ *     clock-frequency = <0x12c0000>;
+ *     current-speed = <38400>;
+ *     reg-shift = <0x02>;
+ *     reg-offset = <0x20>;
+ *     reg-io-width = <0x04>;
+ *     no-loopback-test = <0x01>;
+ *   };
+ *
+ * If CONFIG_BAUDRATE==115200, the function ensures:
+ *   current-speed = <115200>;
+ *
+ * @return 0 if successful, or FDT_ERR... if not.
+ */
+int uart_baudrate_fixup(void *fdt, int node, char *name, char *value)
+{
+	const char *uart_compatible = "andestech,uart16550";
+	const char *current_speed_name = "current-speed";
+	int node_offset = -1;
+	int ret;
+	int config_baudrate = CONFIG_BAUDRATE;
+
+	/* Iterate through all nodes to find UART nodes */
+	while ((node_offset = fdt_node_offset_by_compatible(
+			fdt, node_offset, uart_compatible)) >= 0) {
+		const u32 *current_speed;
+		int len;
+
+		/* Check if `current-speed` already exists */
+		current_speed = fdt_getprop(fdt, node_offset,
+					    current_speed_name, &len);
+		if (current_speed) {
+			dtb_info("Node: %s, Current-speed: %d\n",
+				 fdt_get_name(fdt, node_offset, NULL),
+				 *current_speed);
+
+			/* Skip if speed matches config */
+			if (*current_speed == config_baudrate)
+				continue;
+
+			/* If it exists, update the value */
+			ret = fdt_setprop_u32(fdt, node_offset,
+					      current_speed_name,
+					      config_baudrate);
+			if (ret) {
+				dtb_error("Failed to update %s: %s\n",
+					  current_speed_name,
+					  fdt_strerror(ret));
+				return ret;
+			}
+		} else {
+			/* If it does not exist, add the property */
+			ret = fdt_appendprop_u32(fdt, node_offset,
+						 current_speed_name,
+						 config_baudrate);
+			if (ret) {
+				dtb_error("Failed to add %s: %s\n",
+					  current_speed_name,
+					  fdt_strerror(ret));
+				return ret;
+			}
+			dtb_info("Node: %s, Current-speed: %d\n",
+				 fdt_get_name(fdt, node_offset, NULL),
+				 config_baudrate);
+		}
+
+		/* Debug output to show the result */
+		show_result(fdt, node_offset, current_speed_name,
+			    RESULT_NUMERAL);
+	}
+
+	/* If no UART nodes were found, return an error */
+	if (node_offset < 0 && node_offset != -FDT_ERR_NOTFOUND) {
+		dtb_error("Error while searching for UART nodes: %s\n",
+			  fdt_strerror(node_offset));
+		return node_offset;
+	}
+
+	return RETURN_DONE;
 }
