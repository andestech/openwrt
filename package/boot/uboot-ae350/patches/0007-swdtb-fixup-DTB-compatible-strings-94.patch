diff --git a/board/andestech/common/swdtb_merger/swdtb_merger.c b/board/andestech/common/swdtb_merger/swdtb_merger.c
index 8b6c843f95cf..272a75996bcd 100644
--- a/board/andestech/common/swdtb_merger/swdtb_merger.c
+++ b/board/andestech/common/swdtb_merger/swdtb_merger.c
@@ -15,6 +15,144 @@
 #include <fdt.h>
 #include "swdtb_merger.h"
 
+/*
+ * The table for adding property or changing node information.
+ * Assign the value of the first element to be SWDTB_ENABLE
+ * or SWDTB_DISABLE to enable or disable a sub-feature.
+ */
+struct swdtb_table dtb_merge_table[] = {
+	{SWDTB_ENABLE,	1,
+	 "plicsw compatible string",	plicsw_fixup},
+	{SWDTB_ENABLE,	1,
+	 "plmt compatible string",	plmt_fixup},
+	{SWDTB_ENABLE,	1,
+	 "using generic dma",		using_generic_dma},
+	{SWDTB_ENABLE,	1,
+	 "using generic sdc",		using_generic_sdc},
+	{SWDTB_ENABLE,	1,
+	 "change ax25 to ae350",	ae350_fixup},
+};
+
+static void process_string_data(void *blob, int node, char *name, char *value)
+{
+	int element_cnt;
+	int ret;
+
+	dtb_debug("Name(s): %s: %s\n", name, value);
+	element_cnt = sizeof(dtb_merge_table) / sizeof(struct swdtb_table);
+
+	for (int idx = 0 ; idx < element_cnt; idx++) {
+		if (dtb_merge_table[idx].enable &&
+		    dtb_merge_table[idx].count) {
+			ret = dtb_merge_table[idx].fixup((void *)blob, node,
+							 (char *)name, value);
+			if (!ret && dtb_merge_table[idx].count &&
+			    dtb_merge_table[idx].count < COUNT_MAX) {
+				/* to reduce the loop */
+				dtb_merge_table[idx].count--;
+			}
+		}
+	}
+}
+
+static void process_numeral_data(void *blob, int node, char *name, int len)
+{
+#if ANDES_SWDTB_MERGER_DEBUG_MSG
+	const u32 *value;
+
+	value = fdt_getprop(blob, node, name, NULL);
+	if ((value) && (len % 4 == 0)) {
+		for (int idx = 0; idx < len / 4; idx++) {
+			dtb_debug("Name: %s: %08x\n",
+				  name, fdt32_to_cpu(*(value + idx)));
+		}
+	}
+#endif
+	/* Still no code here */
+}
+
+/**
+ * List all properties in a node, one per line.
+ * @blob:	FDT blob
+ * @node:	Node to display
+ *
+ * @return 0 if ok, or FDT_ERR... if not.
+ */
+static int list_properties(const void *blob, int node)
+{
+	const struct fdt_property *data;
+	const char *name;
+	u32 len;
+	int prop;
+
+	prop = fdt_first_property_offset(blob, node);
+	do {
+		/* Stop silently when there are no more properties */
+		if (prop < 0)
+			return prop == -FDT_ERR_NOTFOUND ? 0 : prop;
+
+		data = fdt_get_property_by_offset(blob, prop, &len);
+		name = fdt_string(blob, fdt32_to_cpu(data->nameoff));
+		if (name) {
+			if (fdt_data_is_one_string(data->data, len)) {
+				/* The String data */
+				process_string_data((void *)blob, node,
+						    (char *)name,
+						    (char *)data->data);
+			} else {
+				/* The numeral data */
+				process_numeral_data((void *)blob, node,
+						     (char *)name, len);
+			}
+		}
+		prop = fdt_next_property_offset(blob, prop);
+	} while (1);
+}
+
+/**
+ * Traverse all of node and its property
+ * support 3 sub-layer under "/"", ae350 max is 4 layer.
+ * the order is root -> node -> subnode -> childnode
+ * The time complexity is O(M x N)
+ * M is the properties of the target DTB
+ * N is the element of dtb_merge_table
+ * @fdt_blob:	The address for the fdt_blob
+ */
+static int swdtb_find_node(void *fdt)
+{
+	int parent, node, subnode, childnode;
+
+	dtb_debug("Address:%016lx\n", (unsigned long)fdt);
+
+	parent = fdt_path_offset(fdt, "/");
+	if (parent < 0) {
+		log_err("Error on find /\n");
+		return -ENODEV;
+	}
+
+	/* For root node property, like compatible string */
+	list_properties(fdt, node);
+
+	fdt_for_each_subnode(node, fdt, parent) {
+		list_properties(fdt, node);
+
+		fdt_for_each_subnode(subnode, fdt, node) {
+			list_properties(fdt, subnode);
+
+			/* For the changed Flash information under the node of
+			 * the SPI, we need add one more layer.
+			 * It's full path is "/" => "soc" => spi => flash
+			 */
+			fdt_for_each_subnode(childnode, fdt, subnode) {
+				/* For level 3 subnode */
+				list_properties(fdt, childnode);
+			}
+		}
+	}
+
+	return 0;
+}
+
 /**
  * The main entry of swdtb merger
  * @fdt_blob:	The address for the fdt_blob
@@ -26,6 +164,16 @@ void swdtb_merger(void *fdt_blob)
 	console_record_reset_enable();
 
 	printf("Using swdtb merger\n");
+
+	if (fdt_magic((void *)fdt_blob) != FDT_MAGIC) {
+		printf("FDT_MAGIC is not match\n");
+		return;
+	}
+
+	/* Increase fdt space */
+	fdt_increase_size(fdt_blob, 2048);
+
+	swdtb_find_node(fdt_blob);
 }
 
