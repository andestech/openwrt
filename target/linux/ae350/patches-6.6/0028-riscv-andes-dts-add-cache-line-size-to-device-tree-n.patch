 arch/riscv/boot/dts/andes/ax45mpv_c4_d_dsp_ae350.dts            | 1 +
 arch/riscv/boot/dts/andes/ax65mp_c2_d_dsp_ae350.dts             | 1 +
 10 files changed, 10 insertions(+)

diff --git a/arch/riscv/boot/dts/andes/a25mp_c4_d_dsp_ae350.dts b/arch/riscv/boot/dts/andes/a25mp_c4_d_dsp_ae350.dts
