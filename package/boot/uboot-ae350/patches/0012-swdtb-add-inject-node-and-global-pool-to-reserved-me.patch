diff --git a/board/andestech/common/swdtb_merger/swdtb_config.h b/board/andestech/common/swdtb_merger/swdtb_config.h
index 3011ad40b6ea..2aa355ee4fb9 100644
--- a/board/andestech/common/swdtb_merger/swdtb_config.h
+++ b/board/andestech/common/swdtb_merger/swdtb_config.h
@@ -42,4 +42,11 @@
 	printf("******************************\n");       \
 } while (0)
 
+/* For adding a new node to the reserved memory */
+#define ANDES_INJECT_NODE_START		(0x100000)
+#define ANDES_INJECT_NODE_SIZE		(0x100000)
+
+#define ANDES_DMA_POOL_NODE_START	(0x3E800000)
+#define ANDES_DMA_POOL_NODE_SIZE	(0x200000)
+
 #endif
diff --git a/board/andestech/common/swdtb_merger/swdtb_merger.c b/board/andestech/common/swdtb_merger/swdtb_merger.c
index db3149dbf780..0d288748def6 100644
--- a/board/andestech/common/swdtb_merger/swdtb_merger.c
+++ b/board/andestech/common/swdtb_merger/swdtb_merger.c
@@ -51,6 +51,17 @@ struct swdtb_table dtb_merge_table[] = {
 	 "dma type to lcd",		dma_type_to_lcd_fixup},
 };
 
+/*
+ * The table is for appending nodes only.
+ * If you want to disable a sub-feature, change SWDTB_ENABLE to SWDTB_DISABLE
+ */
+struct swdtb_table dtb_insert_table[] = {
+	{SWDTB_ENABLE,	1,
+	 "insert inject node",		insert_inject_node},
+	{SWDTB_ENABLE,	1,
+	 "insert global dma pool node",	dma_global_pool_fixup},
+};
+
 static void process_string_data(void *blob, int node, char *name, char *value)
 {
 	int element_cnt;
@@ -89,6 +100,24 @@ static void process_numeral_data(void *blob, int node, char *name, int len)
 	/* Still no code here */
 }
 
+static void process_insert_node(void *fdt)
+{
+	int element_cnt;
+
+	/* Begin appending a new node.*/
+	element_cnt = sizeof(dtb_insert_table) / sizeof(struct swdtb_table);
+	for (int idx = 0 ; idx < element_cnt; idx++) {
+		if (dtb_insert_table[idx].enable &&
+		    dtb_insert_table[idx].count) {
+			/*
+			 * There is no need to decrease the count, as the
+			 * function is executed only once here.
+			 */
+			dtb_insert_table[idx].fixup(fdt, 0, NULL, NULL);
+		}
+	}
+}
+
 /**
  * List all properties in a node, one per line.
  * @blob:	FDT blob
@@ -168,6 +197,8 @@ static int swdtb_find_node(void *fdt)
 		}
 	}
 
+	process_insert_node(fdt);
+
 	return 0;
 }
 
diff --git a/board/andestech/common/swdtb_merger/swdtb_merger_fixup.c b/board/andestech/common/swdtb_merger/swdtb_merger_fixup.c
