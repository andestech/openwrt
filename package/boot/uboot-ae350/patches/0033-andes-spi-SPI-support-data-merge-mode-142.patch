 }
 
-static int __nspi_espi_rx(struct nds_spi_subordinate *ns, void *din, unsigned int bytes)
+static inline void __nspi_espi_rx(struct nds_spi_subordinate *ns, void *din)
 {
-	*(u8 *)din = ns->regs->data;
-	return bytes;
+	if (ns->data_merge)
+		*(u32 *)din = ns->regs->data;
+	else
+		*(u8 *)din = ns->regs->data;
 }
 
+static void pio_transfer_data(struct nds_spi_subordinate *ns,
+			      void *data_in, const void *data_out, int num_blks)
+{
+	int tx_count = 0, rx_count = 0;
+	int num_byte;
+	int timeout;
+
+	if (ns->dout)
+		tx_count = ((ns->regs->tctrl >> 12) & CNT_MASK) + 1;
+	if (ns->din)
+		rx_count = ((ns->regs->tctrl >> 0) & CNT_MASK) + 1;
+
+	num_byte = (ns->regs->format & DATA_MERGE) ? 4 : 1;
+	timeout = SPI_TIMEOUT;
+	while (num_blks && timeout--) {
+		unsigned int event;
+		unsigned int transfer_bytes;
+		int i;
+		int xf_cnt;
+
+		event = in_le32(&ns->regs->status);
+		if (!(event & TXFFL) && data_out) {
+			xf_cnt = (TXFVE_MASK - (event & TXFVE_MASK)) >> TXFVE_OFFSET;
+			transfer_bytes = min3(xf_cnt, CHUNK_SIZE, num_blks);
+			for (i = 0; i < transfer_bytes; i++) {
+				__nspi_espi_tx(ns, data_out);
+				data_out = (u8 *)data_out + num_byte;
+				tx_count = tx_count - num_byte;
+			}
+		}
+		event = in_le32(&ns->regs->status);
+		if ((event & RXFVE_MASK) && data_in) {
+			xf_cnt = (event & RXFVE_MASK) >> RXFVE_OFFSET;
+			transfer_bytes = min3(xf_cnt, CHUNK_SIZE, num_blks);
+			for (i = 0; i < transfer_bytes; i++) {
+				__nspi_espi_rx(ns, data_in);
+				data_in = (u8 *)data_in + num_byte;
+				rx_count = rx_count - num_byte;
+			}
+		}
+		num_blks = max(tx_count, rx_count);
+
+		if (!timeout) {
+			debug("spi_xfer: %s() timeout\n", __func__);
+			break;
+		}
+	}
+}
 
