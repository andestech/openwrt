index 30df912859c9..f1155f16183c 100644
--- a/platform/generic/configs/andes_defconfig
+++ b/platform/generic/configs/andes_defconfig
@@ -9,3 +9,5 @@ CONFIG_FDT_SERIAL=y
 CONFIG_FDT_SERIAL_UART8250=y
 CONFIG_FDT_TIMER=y
 CONFIG_FDT_TIMER_PLMT=y
+CONFIG_FDT_CACHE=y
+CONFIG_FDT_CACHE_ANDES_L2C=y
diff --git a/platform/generic/include/andes/andes.h b/platform/generic/include/andes/andes.h
index 823b27c1edca..1b825c4d2cf1 100644
--- a/platform/generic/include/andes/andes.h
+++ b/platform/generic/include/andes/andes.h
@@ -60,6 +60,8 @@
 #define CSR_MMSC_CFG2		0xfc3
 #define CSR_MVEC_CFG		0xfc7
 #define CSR_MMSC_CFG_PFT_MASK	(1 << 4)
+#define CSR_MMSC_CFG_L2C_MASK	(1UL << 46)
+#define CSR_MMSC_CFG2_L2C_MASK	(1UL << 14)
 
 /* Counter Related Registers */
 #define CSR_MCOUNTERWEN		0x7ce
