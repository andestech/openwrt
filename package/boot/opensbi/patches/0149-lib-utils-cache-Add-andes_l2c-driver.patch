From 2e3f382a38463f28e0807e5c5fb042a61db629da Mon Sep 17 00:00:00 2001
From: Yu Chien Peter Lin <peterlin@andestech.com>
Date: Mon, 8 May 2023 16:26:33 +0800
Subject: [PATCH 149/172] lib: utils: cache: Add andes_l2c driver

Implement andes_l2c_enable/wbinval_all/get_addr function.

Reformed from the following patches on ast-v5_3_0-branch
- (775311967516) lib: utils/cache: Add andes_l2c driver
- (4237cc84d94b) lib: utils/cache: Fix riscv32 address data type (#68)
- (de729b20aa1e) andes: andes_sbi: Fix wbinval_all warning when L2C does  not exist
- (e653f16a9ff5) lib: utils/cache: Add "get_addr" method for cache framework

Signed-off-by: Hui Min Mina Chou <minachou@andestech.com>
---
 lib/utils/cache/Kconfig                  |   8 +
 lib/utils/cache/fdt_cache_andes_l2c.c    | 182 +++++++++++++++++++++++
 lib/utils/cache/objects.mk               |   3 +
 platform/generic/andes/ae350.c           |   2 +
 platform/generic/configs/andes_defconfig |   2 +
 platform/generic/include/andes/andes.h   |   2 +
 6 files changed, 199 insertions(+)
 create mode 100644 lib/utils/cache/fdt_cache_andes_l2c.c

diff --git a/lib/utils/cache/Kconfig b/lib/utils/cache/Kconfig
index a5d0540cc4fe..6898a2df0289 100644
--- a/lib/utils/cache/Kconfig
+++ b/lib/utils/cache/Kconfig
@@ -8,6 +8,14 @@ config FDT_CACHE
 	select CACHE
 	default n
 
+if FDT_CACHE
+
+config FDT_CACHE_ANDES_L2C
+	bool "Andes L2 cache controller"
+	default n
+
+endif
