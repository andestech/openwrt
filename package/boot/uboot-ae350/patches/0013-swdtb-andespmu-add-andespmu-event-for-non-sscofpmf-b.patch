+#define ANDES_TAKEN_CONDITION_BR		0x90   /*  Y  Y  Y  Y */
+#define ANDES_JAL_INST				0xA0   /*  Y  Y  Y  Y */
+#define ANDES_JALR_INST				0xB0   /*  Y  Y  Y  Y */
