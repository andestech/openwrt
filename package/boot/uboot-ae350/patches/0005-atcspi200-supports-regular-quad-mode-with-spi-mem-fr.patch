+static void atcspi200_set_transfer_ctl(struct nds_spi_slave *ns,
+				       const struct spi_mem_op *op)
+{
+	int tc = 0;
+
+	if (op->cmd.nbytes)
+		tc |= CMD_EN(op->cmd.nbytes);
+	if (op->addr.nbytes) {
+		tc |= ADDR_EN(op->addr.nbytes);
+		if (op->addr.buswidth > 1)
+			tc |= ADDR_FMT(1);
+	}
+	if (op->data.nbytes) {
+		switch (op->data.buswidth) {
+		case REGULAR_MODE:
+			tc |= DUAL_QUAD(0);
+			break;
+		case DUAL_MODE:
+			tc |= DUAL_QUAD(1);
+			break;
+		case QUAD_MODE:
+			tc |= DUAL_QUAD(2);
+			break;
+		default:
+			BUG_ON(1);
+			break;
+		}
+		if (op->data.dir == SPI_MEM_DATA_IN) {
+			if (op->dummy.nbytes) {
+				tc |= TRAMODE_DR;
+				if (tc & DUAL_QUAD(2)) {
+					tc |= DUMMY_CNT(2);
+					tc |= TOKEN_EN(1);
+				}
+			} else {
+				tc |= TRAMODE_RO;
+			}
+			tc |= RDTRAN_CNT(op->data.nbytes);
+		} else {
+			tc |= TRAMODE_WO;
+			tc |= WRTRAN_CNT(op->data.nbytes);
+		}
+	} else {
+		tc |= TRAMODE_NONE;
+	}
+	ns->regs->tctrl = tc;
+}
+
+static int atcspi200_spi_setting(struct nds_spi_slave *ns,
+				 const struct spi_mem_op *op)
+{
+	atcspi200_set_transfer_ctl(ns, op);
+	if (op->addr.nbytes)
+		ns->regs->addr = op->addr.val;
+	ns->regs->cmd = op->cmd.opcode;
+	pio_enable = 1;
+
+	return 0;
+}
+
+static int atcspi200_nor_adjust_op_size(struct spi_slave *slave,
+					struct spi_mem_op *op)
+{
+	unsigned int max_transfer_len = MAX_TRANSFER_LEN;
+
+	op->data.nbytes = min(op->data.nbytes, max_transfer_len);
+	return 0;
+}
