+++ b/arch/riscv/boot/dts/andes/a25mp_c4_d_dsp_ae350.dts
@@ -130,6 +130,7 @@ l2-cache@e0500000 {
 		compatible = "cache";
 		cache-level = <0x02>;
 		cache-size = <0x40000>;
+		cache-line-size = <32>;
 		reg = <0x00 0xe0500000 0x00 0x10000>;
 		phandle = <0x01>;
 	};
