+/**
+ * The dma_type_to_xxx_fixup functions use a global variable to
+ * record whether the DMA is dma-coherent or dma-noncoherent.
+ *
+ * @return 0 if ok, or FDT_ERR... if not.
+ */
+int dma_type_to_dma_fixup(void *fdt, int node, char *name, char *value)
+{
+	const char *target_node = "dma";
+	const char *full_name;
+	int ret;
+
+	full_name = fdt_get_name(fdt, node, NULL);
+	if (strncmp(full_name, target_node, strlen(target_node)) == 0) {
+		ret = dma_type_to_node(fdt, node, name, target_node);
+		return ret;
+	}
+	return !(RETURN_DONE);
+}
+
