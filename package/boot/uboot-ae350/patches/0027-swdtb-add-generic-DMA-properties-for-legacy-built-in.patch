diff --git a/board/andestech/common/swdtb_merger/swdtb_tool.c b/board/andestech/common/swdtb_merger/swdtb_tool.c
index f07b44d19016..59bda2e6af93 100644
--- a/board/andestech/common/swdtb_merger/swdtb_tool.c
+++ b/board/andestech/common/swdtb_merger/swdtb_tool.c
@@ -113,8 +113,13 @@ int dma_type_to_node(void *fdt, int node, char *name, const char *target_node)
 			global_dma_type = DMA_TYPE_COHERENT;
 			printf("Bitmap's DMA type is %s\n", target_1);
 		} else {
-			global_dma_type = DMA_TYPE_NONCOHERENT;
-			printf("Bitmap's DMA type is %s\n", target_2);
+			/* The AX45MP_4C Gen1 is using the legecy DMA */
+			dma_type_from_mmc_node(fdt);
+
+			if (global_dma_type == DMA_TYPE_INIT) {
+				global_dma_type = DMA_TYPE_COHERENT;
+				printf("Bitmap's DMA type is %s\n", target_2);
+			}
 		}
 	}
 
@@ -142,6 +147,53 @@ int dma_type_to_node(void *fdt, int node, char *name, const char *target_node)
 	return ret;
 }
 
+int find_node_for_gnog(void *fdt, const char *node_nog, const char *node_g)
+{
+	int offset_nog;
+	int offset_g;
+	int final_node;
+
+	offset_nog = fdt_node_offset_by_compatible(fdt, 0, node_nog);
+
+	offset_g = fdt_node_offset_by_compatible(fdt, 0, node_g);
+
+	if (offset_nog > 0) {
+		dtb_debug("offset_nog is %d\n", offset_nog);
+		final_node = offset_nog;
+	}
+
+	if (offset_g > 0) {
+		dtb_debug("offset_g is %d\n", offset_g);
+		final_node = offset_g;
+	}
+
+	return final_node;
+}
+
+/*
+ * The dma_type_from_mmc_node function attempts to parse
+ * the dma-coherent property from the MMC node.
+ * In most bitmaps, dma-coherent is located in the root of the FDT.
+ * However, in the A[x]45MP4C_Gen1 bitmap, it is placed in
+ * subnodes such as mmc, mac, and lcd
+ */
+void dma_type_from_mmc_node(void *fdt)
+{
+	const char *mmc_compat_g = "andestech,atfsdc010g";
+	const char *mmc_compat = "andestech,atfsdc010";
+	const char *target_1 = "dma-coherent";
+	int mmc_node;
+	const u32 *target_1_idx;
+
+	mmc_node = find_node_for_gnog(fdt, mmc_compat, mmc_compat_g);
+
+	target_1_idx = fdt_getprop(fdt, mmc_node, target_1, NULL);
+	if (target_1_idx) {
+		global_dma_type = DMA_TYPE_COHERENT;
+		printf("Bitmap's DMA type is %s\n", target_1);
+	}
+}
+
 void show_result(const void *fdt, int node, const char *prop_name, int type)
 {
 #ifdef ANDES_SWDTB_MERGER_CHECK
@@ -179,6 +231,25 @@ void show_result(const void *fdt, int node, const char *prop_name, int type)
 #endif
 }
 
+void show_result_multi_num(const void *fdt, int node,
+			   const char *prop_name, int num_count)
+{
+#ifdef ANDES_SWDTB_MERGER_CHECK
+	const char *data;
+	int idx;
+
+	data = (char *)fdt_getprop(fdt, node, prop_name, NULL);
+	if (!data)
+		dtb_error("Error on fdt_getprop\n");
+
+	printf("Result: %s: %s", prop_name, KYEL);
+	for(idx = 0; idx < num_count; idx++) {
+		printf("%d ", fdt32_to_cpu(*((u32 *)data + idx)));
+	}
+	printf("%s\n", KNRM);
+#endif
+}
+
 int show_reserved_memory_node(const void *fdt, int node,
 			      const char *compatible)
 {
