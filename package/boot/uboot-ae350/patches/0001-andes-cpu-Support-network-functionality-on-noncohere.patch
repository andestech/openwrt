diff --git a/arch/riscv/lib/sbi.c b/arch/riscv/lib/sbi.c
index 35a7d3b12f51..4532804cc657 100644
--- a/arch/riscv/lib/sbi.c
+++ b/arch/riscv/lib/sbi.c
@@ -220,6 +220,35 @@ int sbi_dbcn_write_byte(unsigned char ch)
 	return ret.error;
 }
 
+/* Andes PMA SBI call */
+long sbi_pma_probe(void)
+{
+	struct sbiret ret;
+
+	ret = sbi_ecall(SBI_EXT_ANDES, SBI_EXT_ANDES_PMA_PROBE, 0, 0, 0, 0, 0, 0);
+
+	if (!ret.error)
+		return ret.value;
+
+	return -ENOTSUPP;
+}
+
+void sbi_pma_set(phys_addr_t pa, unsigned long va, size_t size)
+{
+	sbi_ecall(SBI_EXT_ANDES, SBI_EXT_ANDES_PMA_SET, pa, va, size, 0, 0, 0);
+}
+
+void sbi_pma_free(unsigned long va)
+{
+	sbi_ecall(SBI_EXT_ANDES, SBI_EXT_ANDES_PMA_FREE, va, 0, 0, 0, 0, 0);
+}
+
+/* Andes enable cache SBI call */
+void sbi_enable_dcache(void)
+{
+	sbi_ecall(SBI_EXT_ANDES, SBI_EXT_ANDES_DCACHE_EN, 1, 0, 0, 0, 0, 0);
+}
+
