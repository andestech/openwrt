@@ -95,12 +97,29 @@ void *board_fdt_blob_setup(int *err)
 
 	if (fdt_magic(CONFIG_SYS_FDT_BASE) == FDT_MAGIC)
 		return (void *)CONFIG_SYS_FDT_BASE;
-	return (void *)ANDES_HW_DTB_ADDRESS;
 
-	*err = -EINVAL;
+	if (fdt_magic(ANDES_HW_DTB_ADDRESS) == FDT_MAGIC)
+		return (void *)ANDES_HW_DTB_ADDRESS;
+
 	return NULL;
 }
 
+void *board_fdt_blob_setup(int *err)
+{
+	void *fdt_blob = ae350_find_fdt_blob();
+
+	if (!fdt_blob) {
+		*err = -EINVAL;
+	} else {
+		*err = 0;
+#ifdef ANDES_SWDTB_MERGER
+		swdtb_merger_hook_fdtblob(&fdt_blob);
+#endif
+	}
+
+	return fdt_blob;
+}
+
